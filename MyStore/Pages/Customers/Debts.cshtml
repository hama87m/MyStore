@page
@model MyStore.Pages.Customers.DebtsModel
@{
    ViewData["Title"] = "قەرزەکان و پارەدانەکان";
}

<style>
    /* ══ هێنانی فۆنتەکە ══ */
    @@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap');

    main, .container, .container-fluid, .p-3, .p-4, .pb-3, .content-wrapper, .body-content {
        padding: 0 !important
    }

    footer {
        display: none !important
    }

    :root {
        --dt-page: #0b1120;
        --dt-card: rgba(15,23,42,.7);
        --dt-stat: rgba(15,23,42,.6);
        --dt-thead: rgba(15,23,42,.5);
        --dt-hover: rgba(99,102,241,.04);
        --dt-input: rgba(30,41,59,.8);
        --border-card: rgba(148,163,184,.08);
        --border-subtle: rgba(148,163,184,.06);
        --border-input: rgba(148,163,184,.12);
        --border-focus: rgba(129,140,248,.5);
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --text-dim: #475569;
        --accent: #818cf8;
        --accent-text: #a5b4fc;
        --accent-bg: rgba(99,102,241,.12);
        --accent-border: rgba(99,102,241,.2);
        --success: #6ee7b7;
        --success-bg: rgba(52,211,153,.1);
        --danger: #fda4af;
        --danger-bg: rgba(251,113,133,.1);
        --warning: #fcd34d;
        --warning-bg: rgba(252,211,77,.1);
        --info: #93c5fd;
        --info-bg: rgba(59,130,246,.1);
        --gradient-top: linear-gradient(135deg,rgba(30,27,75,.4),rgba(49,46,129,.3),rgba(30,27,75,.2));
        --shadow-sm: none;
        --btn-ghost-bg: rgba(30,41,59,.8);
        --btn-ghost-border: rgba(148,163,184,.1);
    }

    [data-theme="light"] {
        --dt-page: #eef1f6;
        --dt-card: #ffffff;
        --dt-stat: #ffffff;
        --dt-thead: #f8f9fb;
        --dt-hover: rgba(99,102,241,.03);
        --dt-input: #ffffff;
        --border-card: #dde0e7;
        --border-subtle: #eaecf0;
        --border-input: rgba(0,0,0,.12);
        --border-focus: rgba(99,102,241,.45);
        --text-primary: #111827;
        --text-secondary: #374151;
        --text-muted: #4b5563;
        --text-dim: #6b7280;
        --accent: #6366f1;
        --accent-text: #4338ca;
        --accent-bg: rgba(99,102,241,.06);
        --accent-border: rgba(99,102,241,.12);
        --success: #047857;
        --success-bg: rgba(4,120,87,.08);
        --danger: #be123c;
        --danger-bg: rgba(190,18,60,.06);
        --warning: #b45309;
        --warning-bg: rgba(217,119,6,.08);
        --info: #2563eb;
        --info-bg: rgba(59,130,246,.08);
        --cyan: #0891b2;
        --cyan-bg: rgba(6,182,212,.08);
        --gradient-top: linear-gradient(135deg,rgba(238,242,255,.95),rgba(224,231,255,.7),rgba(238,242,255,.5));
        --shadow-sm: 0 1px 3px rgba(0,0,0,.06);
        --btn-ghost-bg: #ffffff;
        --btn-ghost-border: rgba(0,0,0,.1);
    }

    .dt-page {
        direction: rtl;
        font-family: 'IBM Plex Sans Arabic', sans-serif;
        background: var(--dt-page);
        color: var(--text-primary);
        min-height: 100vh;
        position: relative;
        transition: background .35s, color .35s;
    }

        .dt-page::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 260px;
            background: var(--gradient-top);
            pointer-events: none;
            transition: background .35s
        }

    .dt-in {
        position: relative;
        z-index: 1;
        padding: 20px 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: 100vh;
    }

    .dt-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

        .dt-top h1 {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 2px
        }

        .dt-top p {
            font-size: 11px;
            color: var(--text-muted);
            margin: 0
        }

    .dt-top-ico {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg,#6366f1,#818cf8);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #fff
    }

    .dt-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .btn-act-main {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 30px;
        padding: 0 20px;
        border-radius: 8px;
        border: none;
        color: #ffffff !important;
        font-size: 12px;
        font-weight: 400;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
        overflow: hidden;
        font-family: inherit;
    }

        .btn-act-main i {
            font-size: 15px;
        }

        .btn-act-main::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
            transform: skewX(-20deg);
            transition: left 0.5s ease;
        }

        .btn-act-main:hover {
            transform: translateY(-2px);
        }

            .btn-act-main:hover::after {
                left: 150%;
            }

    .btn-act-green {
        background: linear-gradient(135deg, #10b981, #059669);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }

        .btn-act-green:hover {
            box-shadow: 0 6px 16px rgba(16, 185, 129, 0.35);
        }

    .dt-stats {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 10px;
        flex-shrink: 0
    }

    .dt-st {
        background: var(--dt-stat);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        padding: 14px 16px;
        transition: all .35s;
        box-shadow: var(--shadow-sm);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .dt-st:hover {
            border-color: var(--accent-border);
            transform: translateY(-1px)
        }

    .dt-st-lbl {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 400;
        margin-bottom: 6px
    }

    .dt-st-val {
        font-size: 22px;
        font-weight: 600;
        line-height: 1
    }

    .dt-st-sub {
        font-size: 11px;
        color: var(--text-dim);
        margin-top: 4px
    }

    .dt-st-ico {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0
    }

    .ic-danger {
        background: var(--danger-bg);
        color: var(--danger);
    }

    .ic-warning {
        background: var(--warning-bg);
        color: var(--warning);
    }

    .ic-success {
        background: var(--success-bg);
        color: var(--success);
    }

    .ic-info {
        background: var(--info-bg);
        color: var(--info);
    }

    .ic-indigo {
        background: var(--accent-bg);
        color: var(--accent);
    }

    .dt-card {
        background: var(--dt-card);
        border: 1px solid var(--border-card);
        border-radius: 14px;
        overflow: hidden;
        transition: all .35s;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0
    }

    .dt-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--border-subtle);
        flex-shrink: 0;
        flex-wrap: wrap
    }

    .dt-inp {
        height: 32px;
        padding: 0 12px;
        background: var(--dt-input);
        border: 1px solid var(--border-input);
        border-radius: 7px;
        color: var(--text-primary);
        font-size: 12px;
        font-family: inherit;
        outline: none;
        transition: all .25s
    }

        .dt-inp:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px var(--accent-bg)
        }

        .dt-inp::placeholder {
            color: var(--text-dim);
            opacity: .7
        }

    .view-toggles {
        display: flex;
        background: var(--dt-input);
        border-radius: 7px;
        padding: 2px;
        border: 1px solid var(--border-input);
    }

    .view-toggle {
        padding: 4px 12px;
        font-size: 11px;
        font-weight: 600;
        color: var(--text-dim);
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

        .view-toggle:hover {
            color: var(--text-primary);
        }

        .view-toggle.active {
            background: var(--dt-card);
            color: var(--accent);
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

    .dt-tbl-scroll {
        flex: 1;
        overflow: auto;
        min-height: 0
    }

        .dt-tbl-scroll::-webkit-scrollbar {
            width: 6px;
            height: 6px
        }

        .dt-tbl-scroll::-webkit-scrollbar-track {
            background: var(--dt-card)
        }

        .dt-tbl-scroll::-webkit-scrollbar-thumb {
            background: var(--text-dim);
            border-radius: 6px
        }

    .dt-tbl {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px
    }

        .dt-tbl th {
            padding: 8px 12px;
            text-align: right;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            background: var(--dt-thead);
            border-bottom: 1px solid var(--border-subtle);
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 1;
            transition: all .35s
        }

        .dt-tbl td {
            padding: 7px 12px;
            font-size: 12px;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-subtle);
            vertical-align: middle;
            transition: all .35s
        }

        .dt-tbl tbody tr {
            transition: background .15s
        }

            .dt-tbl tbody tr:hover {
                background: var(--dt-hover)
            }

            .dt-tbl tbody tr:last-child td {
                border-bottom: none
            }

    .b-debt {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: var(--danger-bg);
        color: var(--danger);
        padding: 2px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700
    }

    .b-cnt {
        background: var(--info-bg);
        color: var(--info);
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700
    }

    .act-grp {
        display: flex;
        gap: 4px;
        justify-content: center
    }

    .act-btn {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        transition: all .2s;
        cursor: pointer
    }

    .ab-pay {
        background: var(--success-bg);
        color: var(--success);
        border: 1px solid rgba(52,211,153,.2)
    }

        .ab-pay:hover {
            background: var(--success);
            color: #fff
        }

    .ab-hist {
        background: var(--info-bg);
        color: var(--info);
        border: 1px solid rgba(59,130,246,.2)
    }

        .ab-hist:hover {
            background: var(--info);
            color: #fff
        }

    .ab-print {
        background: var(--accent-bg);
        color: var(--accent);
        border: 1px solid var(--accent-border)
    }

        .ab-print:hover {
            background: var(--accent);
            color: #fff
        }

    .ab-refund {
        background: var(--warning-bg);
        color: var(--warning);
        border: 1px solid rgba(252,211,77,.2);
    }

        .ab-refund:hover {
            background: var(--warning);
            color: #fff;
        }

    .dt-foot {
        padding: 10px 14px;
        border-top: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        color: var(--text-muted);
        flex-shrink: 0;
        flex-wrap: wrap
    }

        .dt-foot b {
            color: var(--text-primary);
            font-weight: 700
        }

    .dt-empty {
        text-align: center;
        padding: 40px 20px;
        color: var(--text-dim);
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center
    }

        .dt-empty i {
            font-size: 2.5rem;
            opacity: .3;
            margin-bottom: 10px
        }

        .dt-empty p {
            font-size: 13px;
            margin: 0
        }

    .dt-modal .modal-content {
        background: var(--dt-card);
        border: 1px solid var(--border-card);
        border-radius: 14px;
        overflow: hidden;
        color: var(--text-primary);
        box-shadow: 0 20px 40px rgba(0,0,0,.3)
    }

    .dt-modal .modal-body {
        background: var(--dt-card);
        padding: 20px
    }

    .dt-modal .modal-footer {
        background: var(--dt-stat);
        border-top: 1px solid var(--border-subtle);
        padding: 12px 20px
    }

    .mh-gr {
        background: linear-gradient(135deg,rgba(52,211,153,.15),rgba(4,120,87,.1));
        border-bottom: 1px solid rgba(52,211,153,.15);
        padding: 15px 20px
    }

    .mh-ye {
        background: linear-gradient(135deg,rgba(252,211,77,.15),rgba(180,83,9,.1));
        border-bottom: 1px solid rgba(252,211,77,.15);
        padding: 15px 20px
    }

    .mh-bl {
        background: linear-gradient(135deg,rgba(59,130,246,.15),rgba(37,99,235,.1));
        border-bottom: 1px solid rgba(59,130,246,.15);
        padding: 15px 20px
    }

    .modal-header {
        border: none
    }

        .modal-header .modal-title {
            color: var(--text-primary);
            font-weight: 800;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px
        }

        .modal-header .btn-close {
            filter: var(--close-filter,invert(1));
            opacity: .6
        }

    .f-wrap {
        position: relative;
        margin-bottom: 12px
    }

        .f-wrap label {
            position: absolute;
            top: 6px;
            right: 10px;
            font-size: 9px;
            color: var(--text-dim);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            pointer-events: none
        }

        .f-wrap input, .f-wrap select {
            width: 100%;
            border: 1.5px solid var(--border-input);
            border-radius: 9px;
            padding: 20px 10px 6px;
            font-size: 13px;
            outline: none;
            transition: border .15s;
            background: var(--dt-input);
            color: var(--text-primary);
            font-family: inherit
        }

            .f-wrap input:focus, .f-wrap select:focus {
                border-color: var(--accent)
            }

            .f-wrap select option {
                background: var(--dt-card);
                color: var(--text-primary)
            }

    .amount-big {
        font-size: 1.3rem !important;
        text-align: center;
        font-weight: 700;
        padding: 22px 10px 8px !important
    }

    .quick-btns {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        margin-top: 6px
    }

    .qb {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        border: 1px solid var(--border-card);
        background: var(--dt-input);
        color: var(--text-dim);
        cursor: pointer;
        transition: all .15s;
        font-family: inherit
    }

        .qb:hover {
            border-color: var(--success);
            color: var(--success)
        }

        .qb.full {
            background: var(--success-bg);
            color: var(--success);
            border-color: rgba(52,211,153,.2)
        }

        .qb.full-refund {
            background: var(--warning-bg);
            color: var(--warning);
            border-color: rgba(252,211,77,.2);
        }

    .info-card {
        background: var(--dt-stat);
        border-radius: 10px;
        padding: 14px;
        border: 1px solid var(--border-card)
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px solid var(--border-subtle);
        font-size: 13px
    }

        .info-row:last-child {
            border-bottom: none
        }

    .btn-save {
        background: linear-gradient(135deg,#059669,#10b981);
        color: #fff;
        border: none;
        border-radius: 9px;
        padding: 9px 22px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        transition: all .2s
    }

        .btn-save:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(16,185,129,.3)
        }

    .btn-refund {
        background: linear-gradient(135deg,#d97706,#b45309);
        color: #fff;
        border: none;
        border-radius: 9px;
        padding: 9px 22px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        transition: all .2s
    }

        .btn-refund:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(217,119,6,.3);
        }

        .btn-save:disabled, .btn-refund:disabled {
            opacity: .4;
            cursor: not-allowed;
            transform: none;
            box-shadow: none
        }

    .btn-ghost {
        background: var(--btn-ghost-bg);
        color: var(--text-secondary);
        border: 1px solid var(--btn-ghost-border);
        border-radius: 9px;
        padding: 8px 16px;
        font-size: 13px;
        cursor: pointer;
        font-family: inherit
    }

    /* ══ دیزاینی نوێی کارتی مێژوو ══ */
    .hist-item {
        background: var(--dt-input);
        border: 1px solid var(--border-card);
        border-radius: 10px;
        margin-bottom: 10px;
        padding: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-right: 4px solid var(--success);
        transition: all .2s;
    }

        .hist-item.is-refund {
            border-right-color: var(--warning);
        }

        .hist-item:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }

    .hist-badge {
        font-size: 10px;
        padding: 3px 8px;
        border-radius: 4px;
        white-space: nowrap;
        font-weight: bold;
    }

    .badge-pay {
        background: var(--success-bg);
        color: var(--success);
    }

    .badge-refund {
        background: var(--warning-bg);
        color: var(--warning);
    }

    @@media(max-width: 1200px) {
        .dt-stats {
            grid-template-columns: repeat(3,1fr)
        }
    }

    @@media(max-width: 992px) {
        .dt-stats {
            grid-template-columns: repeat(2,1fr)
        }
    }

    @@media(max-width: 768px) {
        .dt-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .dt-actions {
            width: 100%;
        }

        .btn-act-main {
            flex: 1;
            justify-content: center;
        }
    }

    @@media(max-width: 576px) {
        .dt-in {
            padding: 12px 12px
        }

        .dt-stats {
            grid-template-columns: 1fr
        }
    }
</style>

<div class="dt-page">
    <div class="dt-in">

        <div class="dt-top">
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="dt-top-ico"><i class="bi bi-journal-text" style="font-size:14px;"></i></div>
                <div><h1>قەرزەکان و پارەدانەکان</h1><p>بەڕێوەبردنی قەرز، پێشینە، و وەرگرتنی پارە</p></div>
            </div>

            <div class="dt-actions">
                <button class="btn-act-main" style="background:var(--dt-input);border:1px solid var(--border-input);color:var(--text-primary)!important;" onclick="openPayModal(0,'',0)">
                    <i class="bi bi-cash-stack" style="color:var(--success);"></i> وەرگرتنی پارە
                </button>
                <button class="btn-act-main" style="background:var(--dt-input);border:1px solid var(--border-input);color:var(--text-primary)!important;" onclick="openHistory(0)">
                    <i class="bi bi-card-list" style="color:var(--info);"></i> گشت پارەدانەکان
                </button>
            </div>
        </div>

        <div class="dt-stats">
            <!-- کارتی نوێی کۆی کڕیارەکان -->
            <div class="dt-st">
                <div>
                    <div class="dt-st-lbl">کۆی کڕیارەکان</div>
                    <div class="dt-st-val" style="color:var(--accent-text);">@Model.AllCustomersList.Count</div>
                    <div class="dt-st-sub">کەس</div>
                </div>
                <div class="dt-st-ico ic-indigo"><i class="bi bi-people-fill"></i></div>
            </div>

            <div class="dt-st">
                <div>
                    <div class="dt-st-lbl">کڕیاری قەرزدار</div>
                    <div class="dt-st-val" style="color:var(--danger);">@Model.TotalDebtors</div>
                    <div class="dt-st-sub">کەس</div>
                </div>
                <div class="dt-st-ico ic-danger"><i class="bi bi-person-dash"></i></div>
            </div>

            <div class="dt-st">
                <div>
                    <div class="dt-st-lbl">کۆی قەرز</div>
                    <div class="dt-st-val" style="color:var(--warning);">@Model.TotalStoreDebt.ToString("N0")</div>
                    <div class="dt-st-sub">دینار</div>
                </div>
                <div class="dt-st-ico ic-warning"><i class="bi bi-wallet2"></i></div>
            </div>

            <div class="dt-st">
                <div>
                    <div class="dt-st-lbl">کڕیاری خاوەن پێشینە</div>
                    <div class="dt-st-val" style="color:var(--info);">@Model.TotalCreditors</div>
                    <div class="dt-st-sub">کەس</div>
                </div>
                <div class="dt-st-ico ic-info"><i class="bi bi-person-check"></i></div>
            </div>

            <div class="dt-st">
                <div>
                    <div class="dt-st-lbl">کۆی پێشینە</div>
                    <div class="dt-st-val" style="color:var(--success);">@Model.TotalStoreCredit.ToString("N0")</div>
                    <div class="dt-st-sub">دینار</div>
                </div>
                <div class="dt-st-ico ic-success"><i class="bi bi-safe"></i></div>
            </div>
        </div>

        <div class="dt-card">
            <div class="dt-toolbar">
                <i class="bi bi-search" style="color:var(--text-dim);font-size:12px;"></i>
                <input type="text" id="srch-debt" class="dt-inp" placeholder="ناو یان مۆبایل..." style="flex:1;max-width:240px;" value="@Model.SearchCustomer">
                @if (!string.IsNullOrEmpty(Model.SearchCustomer))
                {
                    <button style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:12px;" onclick="window.location='/Customers/Debts'"><i class="bi bi-x-lg"></i></button>
                }

                <div class="view-toggles" style="margin-right:15px;">
                    <a href="?ShowAll=false@(string.IsNullOrEmpty(Model.SearchCustomer) ? "" : $"&SearchCustomer={Model.SearchCustomer}")" class="view-toggle @(!Model.ShowAll ? "active" : "")">قەرزدارەکان</a>
                    <a href="?ShowAll=true@(string.IsNullOrEmpty(Model.SearchCustomer) ? "" : $"&SearchCustomer={Model.SearchCustomer}")" class="view-toggle @(Model.ShowAll ? "active" : "")">هەموو کڕیارەکان</a>
                </div>

                <span style="margin-right:auto;font-size:11px;color:var(--text-dim);">@Model.DebtList.Count کڕیار لە خشتەکەدان</span>
            </div>
            @if (Model.DebtList.Any())
            {
                <div class="dt-tbl-scroll">
                    <table class="dt-tbl">
                        <thead>
                            <tr>
                                <th style="width:4%;text-align:center;">#</th>
                                <th>کڕیار</th>
                                <th style="width:10%;">مۆبایل</th>
                                <th style="width:7%;text-align:center;">پسوڵە</th>
                                <th style="width:13%;text-align:center;">کۆی پسوڵەکان</th>
                                <th style="width:13%;text-align:center;">واصڵکراو</th>
                                <th style="width:13%;text-align:center;">باڵانس</th>
                                <th style="width:12%;text-align:center;">کردار</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int idx = 1;
                            }
                            @foreach (var d in Model.DebtList)
                            {
                                <tr>
                                    <td style="text-align:center;color:var(--text-dim);font-size:11px;">@idx</td>
                                    <td><span style="font-weight:700;color:var(--text-primary);">@d.CustomerName</span></td>
                                    <td style="font-family:monospace;color:var(--text-dim);">@d.Phone</td>
                                    <td style="text-align:center;"><span class="b-cnt">@d.UnpaidInvoices</span></td>
                                    <td style="text-align:center;font-weight:600;">@d.TotalDebt.ToString("N0")</td>
                                    <td style="text-align:center;font-weight:600;color:var(--success);">@d.TotalPaid.ToString("N0")</td>
                                    <td style="text-align:center;">
                                        @if (d.Balance > 0)
                                        {
                                            <span class="b-debt">@d.Balance.ToString("N0")</span>
                                        }
                                        else if (d.Balance < 0)
                                        {
                                            <span class="b-cnt" style="background:var(--success-bg);color:var(--success);border:1px solid rgba(52,211,153,.2);">@Math.Abs(d.Balance).ToString("N0") (پێشینە)</span>
                                        }
                                        else
                                        {
                                            <span class="b-cnt" style="background:var(--border-subtle);color:var(--text-dim);">0</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="act-grp">
                                            @if (d.Balance < 0)
                                            {
                                                <button class="act-btn ab-refund" onclick="openRefundModal(@d.CustomerId, '@d.CustomerName.Replace("'", "\\'")', @Math.Abs(d.Balance))" title="پێدانەوەی پێشینە"><i class="bi bi-wallet2"></i></button>
                                            }
                                            <button class="act-btn ab-pay" onclick="openPayModal(@d.CustomerId,'@d.CustomerName.Replace("'", "\\'")' ,@d.Balance)" title="واصڵکردن"><i class="bi bi-cash-coin"></i></button>
                                            <button class="act-btn ab-hist" onclick="openHistory(@d.CustomerId)" title="مێژوو"><i class="bi bi-clock-history"></i></button>
                                        </div>
                                    </td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                    </table>
                </div>
                <!-- فووتەرەکە تەنها ژمارەی کڕیارەکانی خشتەکە نیشان دەدات -->
                <div class="dt-foot">
                    <span><b>@Model.DebtList.Count</b> کڕیار لە خشتەکەدان</span>
                </div>
            }
            else
            {
                <div class="dt-empty"><i class="bi bi-check-circle" style="color:var(--success);"></i><p>هیچ کڕیارێک نەدۆزرایەوە!</p></div>
            }
        </div>

    </div>
</div>

<!-- ═══ مۆدالی واصڵکردن ═══ -->
<div class="modal fade dt-modal" id="m-pay" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header mh-gr"><h5 class="modal-title"><i class="bi bi-cash-coin"></i> <span id="pay-ttl">وەرگرتنی پارە</span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="f-wrap">
                            <select id="pay-cust">
                                <option value="">— کڕیار هەڵبژێرە —</option>
                                @foreach (var c in Model.AllCustomersList)
                                {
                                    <option value="@c.CustomerId" data-bal="@c.Balance">@c.CustomerName @(c.Balance > 0 ? $"(قەرزدار: {c.Balance:N0})" : c.Balance < 0 ? $"(پێشینەی هەیە: {Math.Abs(c.Balance):N0})" : "(باڵانسی پاکە)")</option>
                                }
                            </select>
                            <label>کڕیار</label>
                        </div>
                        <div class="f-wrap">
                            <input type="number" id="pay-amount" class="amount-big" min="0" step="1000" placeholder="0">
                            <label>بڕی پارە (د.ع)</label>
                        </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <small style="color:var(--text-dim);">قەرزی ئێستا: <strong id="pay-max" style="color:var(--danger);">0</strong></small>
                            <span id="pay-warn" style="display:none;color:var(--success);font-size:12px;font-weight:700;">⚠️ دەبێتە پێشینە!</span>
                        </div>
                        <div class="quick-btns">
                            <button type="button" class="qb" onclick="addAmt(5000)">+5,000</button>
                            <button type="button" class="qb" onclick="addAmt(10000)">+10,000</button>
                            <button type="button" class="qb" onclick="addAmt(25000)">+25,000</button>
                            <button type="button" class="qb full" onclick="payFull()">تەواوی قەرز</button>
                        </div>
                        <div class="f-wrap" style="margin-top:12px;">
                            <input type="datetime-local" id="pay-date" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")">
                            <label>بەروار</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-card h-100">
                            <div style="font-size:13px;font-weight:700;margin-bottom:12px;"><i class="bi bi-info-circle" style="color:var(--accent);"></i> زانیاری</div>
                            <div id="pay-info" style="display:none;">
                                <div class="info-row"><span style="color:var(--text-muted);">ناو:</span><strong id="pi-name">-</strong></div>
                                <div class="info-row"><span style="color:var(--text-muted);">باڵانسی کۆن:</span><strong id="pi-old" style="color:var(--danger);">0</strong></div>
                                <div class="info-row"><span style="color:var(--text-muted);">پارەی وەرگیراو:</span><strong id="pi-now" style="color:var(--success);">0</strong></div>
                                <div class="info-row" style="border-top:2px solid var(--border-subtle);padding-top:8px;"><span style="color:var(--text-muted);">باڵانسی نوێ:</span><strong id="pi-new" style="font-size:1rem;">0</strong></div>
                            </div>
                            <div id="pay-empty" class="text-center" style="padding:30px 0;"><i class="bi bi-person" style="font-size:2rem;color:var(--text-dim);opacity:.3;"></i><p style="color:var(--text-dim);margin:8px 0 0;font-size:13px;">کڕیار هەڵبژێرە</p></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-ghost" data-bs-dismiss="modal">داخستن</button>
                <button type="button" class="btn-save" id="pay-save" disabled onclick="savePayment()"><i class="bi bi-check-lg"></i> پاشەکەوتکردن</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade dt-modal" id="m-refund" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:400px;">
        <div class="modal-content">
            <div class="modal-header mh-ye"><h5 class="modal-title"><i class="bi bi-wallet2"></i> پێدانەوەی پێشینە</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div style="text-align:center;margin-bottom:15px;">
                    <h5 id="rf-name" style="font-weight:700;margin-bottom:4px;color:var(--text-primary);"></h5>
                    <p style="font-size:13px;color:var(--text-dim);margin:0;">ئەم کڕیارە بڕی <b id="rf-max" style="color:var(--success);"></b> د.ع پێشینەی لای ئێمەیە.</p>
                </div>
                <div class="f-wrap"><input type="number" id="rf-amount" class="amount-big" min="0" step="1000" placeholder="0"><label>بڕی پێدراو بە کاش (د.ع)</label></div>
                <div class="quick-btns" style="justify-content:center;margin-bottom:15px;"><button type="button" class="qb full-refund" onclick="refundFull()">پێدانەوەی تەواوی پێشینەکە</button></div>
                <div class="info-card" style="padding:10px;"><div class="info-row"><span style="color:var(--text-muted);">پێشینەی ماوە دوای ئەمە:</span><strong id="rf-new" style="font-size:1rem;color:var(--success);">0</strong></div></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn-ghost" data-bs-dismiss="modal">داخستن</button><button type="button" class="btn-refund" id="rf-save" disabled onclick="saveRefund()"><i class="bi bi-check-lg"></i> سەلماندن</button></div>
        </div>
    </div>
</div>

<div class="modal fade dt-modal" id="m-hist" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header mh-bl">
                <h5 class="modal-title"><i class="bi bi-clock-history"></i> <span id="hist-ttl">مێژووی پارەدانەکان</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div style="padding:15px;background:var(--dt-stat);border-bottom:1px solid var(--border-subtle);display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                <div class="f-wrap" style="margin:0;flex:1;min-width:200px;">
                    <select id="hist-cust" onchange="fetchHistory()">
                        <option value="0">— هەموو کڕیارەکان —</option>
                        @foreach (var c in Model.AllCustomersList)
                        {
                            <option value="@c.CustomerId">@c.CustomerName</option>
                        }
                    </select>
                    <label>کڕیار</label>
                </div>
                <div class="f-wrap" style="margin:0;width:150px;"><input type="date" id="hist-from" onchange="fetchHistory()"><label>لە بەرواری</label></div>
                <div class="f-wrap" style="margin:0;width:150px;"><input type="date" id="hist-to" onchange="fetchHistory()"><label>بۆ بەرواری</label></div>
                <button class="btn-ghost" style="height:42px;padding:0 15px;" onclick="_$('hist-from').value='';_$('hist-to').value='';fetchHistory();" title="پاککردنەوەی بەروار"><i class="bi bi-x-lg"></i></button>
            </div>

            <div id="hist-advance-box" style="display:none;background:var(--warning-bg);border-bottom:1px solid rgba(252,211,77,.2);padding:10px 20px;"></div>

            <div class="modal-body" style="padding:15px;position:relative;background:var(--dt-page);">
                <div id="hist-loading" style="position:absolute;inset:0;background:var(--dt-card);display:flex;align-items:center;justify-content:center;z-index:10;"><div class="spinner-border text-primary"></div></div>
                <div id="hist-list"></div>
                <div id="hist-empty" style="display:none;text-align:center;padding:40px;color:var(--text-dim);font-size:14px;"><i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:10px;opacity:.3;"></i>هیچ پارەدانێک نەدۆزرایەوە بەم فلتەرانە</div>
            </div>

            <div class="modal-footer" style="padding:12px 20px;background:var(--dt-stat);border-top:1px solid var(--border-subtle);display:flex;justify-content:space-between;align-items:center;font-size:13px;width:100%;">
                <span style="color:var(--text-muted);">کۆی گشتی ئەم لیستە:</span>
                <strong id="hist-total" style="color:var(--success);font-size:16px;">0 د.ع</strong>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        var _curCustId = 0, _curBal = 0;
        var _rfCustId = 0, _rfMaxAmount = 0;
        var _tok = function () { return document.querySelector('input[name="__RequestVerificationToken"]').value };
        var _$ = function (id) { return document.getElementById(id) };
        var fmt = function (n) { return new Intl.NumberFormat('en').format(Math.round(n)) };

        var _srchTimer = null;
        var srchEl = _$('srch-debt');
        if (srchEl) {
            srchEl.addEventListener('input', function () {
                clearTimeout(_srchTimer);
                var v = this.value.trim();
                var isShowAll = '@Model.ShowAll'.toLowerCase() === 'true';
                var showAllParam = isShowAll ? '&ShowAll=true' : '';
                _srchTimer = setTimeout(function () {
                    if (v) window.location = '/Customers/Debts?SearchCustomer=' + encodeURIComponent(v) + showAllParam;
                    else window.location = '/Customers/Debts' + (isShowAll ? '?ShowAll=true' : '');
                }, 400);
            })
        }

        function openPayModal(cid, name, bal) {
            _$('pay-cust').value = cid || '';
            _$('pay-amount').value = '';
            _$('pay-warn').style.display = 'none';
            _$('pay-save').disabled = true;
            if (cid > 0) loadCustInfo(cid);
            else { _$('pay-info').style.display = 'none'; _$('pay-empty').style.display = ''; }
            new bootstrap.Modal(_$('m-pay')).show();
        }

        _$('pay-cust').addEventListener('change', function () {
            var v = this.value;
            if (v) loadCustInfo(v);
            else { _curCustId = 0; _curBal = 0; _$('pay-info').style.display = 'none'; _$('pay-empty').style.display = ''; _$('pay-save').disabled = true; }
        });

        _$('pay-amount').addEventListener('input', calcPay);

        async function loadCustInfo(cid) {
            try {
                var r = await fetch('?handler=CustomerInfo&customerId=' + cid);
                var d = await r.json();
                if (!d.success) return;
                _curCustId = cid; _curBal = d.balance;
                _$('pi-name').textContent = d.customerName;
                _$('pi-old').textContent = fmt(Math.abs(d.balance)) + (d.balance < 0 ? " (پێشینە)" : "");
                _$('pi-old').style.color = d.balance < 0 ? 'var(--success)' : (d.balance > 0 ? 'var(--danger)' : 'var(--text-primary)');
                _$('pay-max').textContent = d.balance > 0 ? fmt(d.balance) : "0";
                _$('pay-info').style.display = ''; _$('pay-empty').style.display = 'none';
                calcPay();
            } catch (e) { }
        }

        function calcPay() {
            var amt = parseFloat(_$('pay-amount').value) || 0;
            var nb = _curBal - amt;
            _$('pi-now').textContent = fmt(amt);
            _$('pi-new').textContent = fmt(Math.abs(nb));
            if (nb > 0) { _$('pi-new').style.color = 'var(--danger)'; _$('pay-warn').style.display = 'none'; }
            else if (nb < 0) { _$('pi-new').style.color = 'var(--success)'; _$('pay-warn').textContent = '⚠️ دەبێتە پێشینە!'; _$('pay-warn').style.display = ''; }
            else { _$('pi-new').style.color = 'var(--text-primary)'; _$('pay-warn').style.display = 'none'; }
            _$('pay-save').disabled = !(amt > 0 && _curCustId > 0);
        }

        function addAmt(n) { _$('pay-amount').value = (parseFloat(_$('pay-amount').value) || 0) + n; calcPay(); }
        function payFull() { _$('pay-amount').value = _curBal > 0 ? _curBal : 0; calcPay(); }

        async function savePayment() {
            var amt = parseFloat(_$('pay-amount').value) || 0;
            if (_curCustId == 0 || amt <= 0) return;
            var btn = _$('pay-save'); btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            var fd = new FormData();
            fd.append('PaymentInput.CustomerId', _curCustId); fd.append('PaymentInput.Amount', amt);
            fd.append('PaymentInput.PaymentDate', _$('pay-date').value); fd.append('__RequestVerificationToken', _tok());
            try {
                var r = await fetch('?handler=Payment', { method: 'POST', body: fd });
                var d = await r.json();
                if (d.success) {
                    var payMdl = bootstrap.Modal.getInstance(_$('m-pay'));
                    if (payMdl) payMdl.hide();

                    if (d.paymentId && confirm('سەرکەوتوو بوو! وەصڵ چاپ دەکەیت؟')) {
                        printInvoice(d.paymentId, false, false);
                    } else { location.reload(); }
                } else { alert(d.message); btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg"></i> پاشەکەوتکردن'; }
            } catch (e) { alert('هەڵە: ' + e); btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg"></i> پاشەکەوتکردن'; }
        }

        function openRefundModal(cid, name, maxAmount) {
            _rfCustId = cid; _rfMaxAmount = maxAmount;
            _$('rf-name').textContent = name; _$('rf-max').textContent = fmt(maxAmount);
            _$('rf-amount').value = ''; _$('rf-new').textContent = fmt(maxAmount); _$('rf-save').disabled = true;
            var histModal = bootstrap.Modal.getInstance(_$('m-hist')); if(histModal) histModal.hide();
            setTimeout(function(){ new bootstrap.Modal(_$('m-refund')).show(); }, 400);
        }

        _$('rf-amount').addEventListener('input', function() {
            var amt = parseFloat(this.value) || 0;
            if(amt > _rfMaxAmount) { this.value = _rfMaxAmount; amt = _rfMaxAmount; }
            var rem = _rfMaxAmount - amt;
            _$('rf-new').textContent = fmt(rem);
            _$('rf-new').style.color = rem == 0 ? "var(--text-primary)" : "var(--success)";
            _$('rf-save').disabled = !(amt > 0 && amt <= _rfMaxAmount);
        });

        function refundFull() { _$('rf-amount').value = _rfMaxAmount; _$('rf-amount').dispatchEvent(new Event('input')); }

        async function saveRefund() {
            var amt = parseFloat(_$('rf-amount').value) || 0;
            if (_rfCustId == 0 || amt <= 0 || amt > _rfMaxAmount) return;
            var btn = _$('rf-save'); btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            var fd = new FormData(); fd.append('customerId', _rfCustId); fd.append('amount', amt); fd.append('__RequestVerificationToken', _tok());
            try {
                var r = await fetch('?handler=RefundAdvance', { method: 'POST', body: fd });
                var d = await r.json();
                if (d.success) {
                    var refMdl = bootstrap.Modal.getInstance(_$('m-refund'));
                    if (refMdl) refMdl.hide();

                    if (d.paymentId && confirm('سەرکەوتوو بوو! وەصڵ چاپ دەکەیت؟')) {
                        printInvoice(d.paymentId, false, true);
                    } else { location.reload(); }
                } else { alert(d.message); btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg"></i> سەلماندن'; }
            } catch (e) { alert('هەڵە: ' + e); btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg"></i> سەلماندن'; }
        }

        function openHistory(cid) { _$('hist-cust').value = cid; new bootstrap.Modal(_$('m-hist')).show(); fetchHistory(); }

        async function fetchHistory() {
            _$('hist-loading').style.display = 'flex'; _$('hist-list').innerHTML = ''; _$('hist-empty').style.display = 'none';
            _$('hist-advance-box').style.display = 'none'; _$('hist-total').textContent = '0 د.ع';
            var cid = _$('hist-cust').value, f = _$('hist-from').value, t = _$('hist-to').value;
            var url = '?handler=PaymentHistory&customerId=' + cid;
            if(f) url += '&fromDate=' + f; if(t) url += '&toDate=' + t;
            try {
                var r = await fetch(url); var d = await r.json();
                _$('hist-loading').style.display = 'none';
                _$('hist-ttl').textContent = cid > 0 ? ('مێژووی پارەدان — ' + d.customerName) : 'مێژووی گشت پارەدانەکان';
                if (cid > 0 && d.balance < 0) {
                    var abox = _$('hist-advance-box');
                    abox.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;">' +
                        '<div><div style="font-size:12px;color:var(--warning);margin-bottom:2px;">پێشینەی ئەم کڕیارە لای ئێمە:</div>' +
                        '<div style="font-size:16px;font-weight:bold;color:var(--text-primary);">' + fmt(Math.abs(d.balance)) + ' د.ع</div></div>' +
                        '<button class="btn-refund" style="padding:7px 14px;font-size:12px;height:auto;" onclick="openRefundModal(' + cid + ',\'' + d.customerName.replace(/'/g,"\\'") + '\',' + Math.abs(d.balance) + ')">' +
                        '<i class="bi bi-wallet2"></i> پێدانەوەی پێشینە</button>' +
                        '</div>';
                    abox.style.display = 'block';
                }
                if (!d.success || !d.payments || d.payments.length === 0) { _$('hist-empty').style.display = 'block'; return; }
                _$('hist-total').textContent = fmt(d.totalAmount) + ' د.ع';

                var h = '', isAll = cid == 0;
                for (var i = 0; i < d.payments.length; i++) {
                    var p = d.payments[i], dt = new Date(p.paymentDate);
                    var isRef = p.note && p.note.includes('پێشینە');
                    var typeClass = isRef ? 'is-refund' : '';
                    var badge = isRef ? '<span class="hist-badge badge-refund">پێدانەوەی پێشینە</span>' : '<span class="hist-badge badge-pay">واصڵکردن</span>';

                    var actBtn = p.isSale ? '<span style="font-size:10px;background:var(--border-subtle);color:var(--text-dim);padding:3px 8px;border-radius:4px;white-space:nowrap;">پارەی پسوڵە</span>' :
                                            '<button class="act-btn" style="background:var(--danger-bg);color:var(--danger);border:1px solid rgba(251,113,133,.2);" onclick="undoPayment(' + p.paymentId + ',' + p.amount + ')" title="پووچەڵکردنەوە"><i class="bi bi-arrow-counterclockwise"></i></button>';

                    var custNameHtml = isAll ? '<div style="font-size:12px;color:var(--text-primary);margin-bottom:6px;font-weight:700;"><i class="bi bi-person text-muted"></i> ' + p.customerName + '</div>' : '';

                    h += '<div class="hist-item ' + typeClass + '">' +
                            '<div>' +
                                custNameHtml +
                                '<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">' +
                                    '<div style="font-weight:800;color:var(--text-primary);font-size:16px;">' + fmt(p.amount) + ' <span style="font-size:11px;color:var(--text-dim);">د.ع</span></div>' +
                                    badge +
                                '</div>' +
                                '<div style="font-size:11px;color:var(--text-dim);font-family:monospace;">' +
                                    '<i class="bi bi-calendar3"></i> ' + dt.toLocaleDateString('en-CA') + ' &nbsp; <i class="bi bi-clock"></i> ' + dt.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) +
                                '</div>' +
                                (p.note ? '<div style="font-size:11px;color:var(--text-muted);margin-top:6px;background:var(--dt-card);padding:4px 8px;border-radius:4px;display:inline-block;"><i class="bi bi-chat-left-text" style="opacity:0.5"></i> ' + p.note + '</div>' : '') +
                            '</div>' +
                            '<div style="display:flex;gap:4px;align-items:center;flex-direction:column;">' +
                                '<button class="act-btn ab-print" style="width:34px;height:34px;font-size:14px;" onclick="printInvoice(' + p.paymentId + ', ' + p.isSale + ', ' + isRef + ')" title="چاپکردنی پسوڵە"><i class="bi bi-printer"></i></button>' +
                                actBtn +
                            '</div>' +
                          '</div>';
                }
                _$('hist-list').innerHTML = h;
            } catch (e) { _$('hist-loading').style.display = 'none'; _$('hist-empty').style.display = 'block'; }
        }

        async function printInvoice(paymentId, isSale = false, isRefundContext = false) {
            try {
                var url = '?handler=PaymentReceipt&paymentId=' + paymentId;
                if (isSale) url += '&isSale=true';

                var res = await fetch(url);
                var data = await res.json();
                if (!data.success) { alert(data.message || 'هەڵە ڕوویدا'); return; }

                var rc = data.receipt;
                var store = data.store;
                var pDate = rc.date + ' ' + rc.time;
                var prevText = rc.prevBalance < 0 ? ' (پێشینە)' : '';
                var newText = rc.newBalance < 0 ? ' (پێشینە)' : '';

                var isRefund = isRefundContext || (rc.newBalance > rc.prevBalance && rc.prevBalance <= 0);
                var titleText = isRefund ? "پسوڵەی پێدانەوەی پێشینە" : "پسوڵەی وەرگرتنی پارە";
                var amountLabel = isRefund ? "بڕی پێدراو:" : "بڕی وەرگیراو:";

                var lHtml = store.logo ? '<img src="' + store.logo + '" style="max-width:80px;max-height:60px;display:block;margin:0 auto 8px"/>' : '';

                var lines = [
                    '<di' + 'v style="font-family:Tahoma,Arial,sans-serif;font-size:12px;width:80mm;padding:5mm;direction:rtl">',
                    '<sty' + 'le>',
                    '.hdr{text-align:center;border-bottom:2px dashed #000;padding-bottom:8px;margin-bottom:8px}',
                    '.sn{font-size:16px;font-weight:bold;margin-bottom:3px}.si{font-size:10px;color:#333}',
                    '.ii{display:flex;justify-content:space-between;font-size:11px;margin-bottom:8px;padding-bottom:6px;border-bottom:1px dashed #000}',
                    '.tot{border-top:2px dashed #000;padding-top:8px}',
                    '.tr{display:flex;justify-content:space-between;padding:3px 0;font-size:12px}',
                    '.tr.grand{font-size:15px;font-weight:bold;border-top:2px solid #000;padding-top:8px;margin-top:6px}',
                    '.tr.debt{color:#c00;font-weight:bold}',
                    '.ftr{text-align:center;margin-top:12px;padding-top:8px;border-top:2px dashed #000;font-size:11px}',
                    '</sty' + 'le>',
                    '<di' + 'v class="hdr">' + lHtml + '<di' + 'v class="sn">' + (store.name || 'فرۆشگا') + '</di' + 'v><di' + 'v class="si">' + (store.address || '') + '</di' + 'v><di' + 'v class="si">' + (store.phone || '') + '</di' + 'v></di' + 'v>',
                    '<di' + 'v class="ii"><sp' + 'an>پسوڵە: <strong>#' + rc.paymentId + '</strong></sp' + 'an><sp' + 'an>' + pDate + '</sp' + 'an></di' + 'v>',
                    '<di' + 'v style="font-size:11px;margin-bottom:4px">کڕیار: <strong>' + rc.customerName + '</strong></di' + 'v>',
                    '<di' + 'v style="font-size:11px;margin-bottom:8px">جۆری پسوڵە: <strong>' + (isRefund ? 'پێدانەوەی پێشینە' : 'وەرگرتنی پارە (واصڵکردن)') + '</strong></di' + 'v>',
                    '<di' + 'v class="tot">',
                    '<di' + 'v class="tr"><sp' + 'an>باڵانسی پێشوو:</sp' + 'an><sp' + 'an>' + fmt(Math.abs(rc.prevBalance)) + prevText + ' د.ع</sp' + 'an></di' + 'v>',
                    '<di' + 'v class="tr grand"><sp' + 'an>' + amountLabel + '</sp' + 'an><sp' + 'an>' + fmt(rc.amount) + ' د.ع</sp' + 'an></di' + 'v>',
                    '<di' + 'v class="tr ' + (rc.newBalance > 0 ? 'debt' : '') + '"><sp' + 'an>باڵانسی نوێ:</sp' + 'an><sp' + 'an>' + fmt(Math.abs(rc.newBalance)) + newText + ' د.ع</sp' + 'an></di' + 'v>',
                    '</di' + 'v>',
                    '<di' + 'v class="ftr"><di' + 'v>سوپاس بۆ مامەڵەکردن لەگەڵمان</di' + 'v><di' + 'v style="margin-top:4px;font-size:10px;color:#666">' + (store.name || 'سیستەمی فرۆشیاری') + '</di' + 'v></di' + 'v>',
                    '</di' + 'v>'
                ];
                var htmlContent = lines.join('');

                var pw = window.open('', '_blank', 'width=400,height=600');
                if (!pw) { alert('پەنجەرەی چاپکردن نەکرایەوە!'); return; }
                pw.document.write(htmlContent);
                pw.document.close();
                pw.onload = () => setTimeout(() => {
                    pw.print();
                    setTimeout(function() {
                        location.reload();
                    }, 500);
                }, 200);

            } catch(e) {
                console.error('هەڵە لە چاپکردن:', e);
                alert('هەڵە لە چاپکردن: ' + e.message);
            }
        }

        async function undoPayment(paymentId, amount) {
            if (!confirm('دڵنیایت لە پووچەڵکردنەوەی ئەم بڕە?\nبڕ: ' + fmt(amount) + ' د.ع')) return;
            var fd = new FormData(); fd.append('paymentId', paymentId); fd.append('__RequestVerificationToken', _tok());
            try {
                var r = await fetch('?handler=UndoPayment&paymentId=' + paymentId, { method: 'POST', body: fd });
                var d = await r.json();
                if (d.success) {
                    location.reload();
                } else alert(d.message);
            } catch (e) { alert('هەڵە: ' + e); }
        }
    </script>
}