@page
@model MyStore.Pages.Suppliers.IndexModel
@{
    ViewData["Title"] = "دابینکەران";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --dark-1: #0f172a;
        --purple: #8b5cf6;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
    }

    .page-wrapper {
        max-width: 960px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
        padding: 14px 18px;
        border-radius: 12px;
        margin-bottom: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        border: 1px solid #f1f5f9;
    }

    .nav-icon-box {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg,#dbeafe,#eff6ff);
        color: var(--info);
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        border: 1px solid #bfdbfe;
        flex-shrink: 0;
    }

    .card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        border: 1px solid #f1f5f9;
        overflow: hidden;
    }

    .card-head {
        padding: 10px 16px;
        background: #fafbfc;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .search-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

        .search-wrap i {
            position: absolute;
            right: 9px;
            color: #94a3b8;
            font-size: .72rem;
            pointer-events: none;
        }

    .search-inp {
        height: 30px;
        padding: 0 28px 0 8px;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        font-size: .75rem;
        outline: none;
        width: 200px;
        transition: border .15s;
    }

        .search-inp:focus {
            border-color: var(--info);
        }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th {
            padding: 8px 14px;
            text-align: right;
            font-size: .63rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            background: #f8fafc;
            border-bottom: 1.5px solid #e2e8f0;
        }

        .data-table td {
            padding: 10px 14px;
            font-size: .76rem;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .data-table tbody tr:hover {
            background: #f8fafc;
        }

        .data-table tbody tr:last-child td {
            border-bottom: none;
        }

    .badge-active {
        background: #dcfce7;
        color: #16a34a;
        border: 1px solid #bbf7d0;
        padding: 2px 9px;
        border-radius: 20px;
        font-size: .67rem;
        font-weight: 700;
    }

    .badge-inactive {
        background: #f1f5f9;
        color: #94a3b8;
        border: 1px solid #e2e8f0;
        padding: 2px 9px;
        border-radius: 20px;
        font-size: .67rem;
        font-weight: 700;
    }

    .badge-count {
        background: linear-gradient(135deg,#dbeafe,#eff6ff);
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
        padding: 2px 9px;
        border-radius: 20px;
        font-size: .67rem;
        font-weight: 700;
    }

    .badge-default {
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #e2e8f0;
        padding: 2px 9px;
        border-radius: 20px;
        font-size: .67rem;
    }

    .action-btn {
        width: 27px;
        height: 27px;
        border-radius: 7px;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .75rem;
        cursor: pointer;
        transition: all .15s;
    }

        .action-btn.edit {
            background: linear-gradient(135deg,#fef3c7,#fefce8);
            color: #b45309;
            border: 1px solid #fde047;
        }

        .action-btn.delete {
            background: linear-gradient(135deg,#fee2e2,#fef2f2);
            color: #dc2626;
            border: 1px solid #fecaca;
        }

        .action-btn.edit:hover {
            background: var(--warning);
            color: #fff;
            border-color: var(--warning);
        }

        .action-btn.delete:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

        .action-btn:disabled {
            opacity: .35;
            cursor: not-allowed;
        }

    .modal-content {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,.15);
    }

    .modal-header {
        padding: 14px 20px;
        border: none;
    }

        .modal-header.blue {
            background: linear-gradient(135deg,#2563eb,#3b82f6);
        }

        .modal-header.warning {
            background: linear-gradient(135deg,var(--warning),#d97706);
        }

        .modal-header.danger {
            background: linear-gradient(135deg,var(--danger),#dc2626);
        }

        .modal-header .modal-title {
            color: #fff;
            font-weight: 700;
            font-size: .9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
            opacity: .8;
        }

    .modal-body {
        padding: 20px;
    }

    .modal-footer {
        background: #f8fafc;
        padding: 12px 20px;
        border: none;
    }

    .pf-wrap {
        position: relative;
        margin-bottom: 12px;
    }

        .pf-wrap label {
            position: absolute;
            top: 6px;
            right: 10px;
            font-size: .57rem;
            color: #94a3b8;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            pointer-events: none;
        }

        .pf-wrap input, .pf-wrap textarea {
            width: 100%;
            border: 1.5px solid #e2e8f0;
            border-radius: 9px;
            padding: 20px 10px 6px;
            font-size: .82rem;
            outline: none;
            transition: border .15s;
            background: #fff;
            color: var(--dark-1);
            font-family: inherit;
            resize: none;
        }

            .pf-wrap input:focus, .pf-wrap textarea:focus {
                border-color: var(--info);
            }

    .btn-add {
        background: linear-gradient(135deg,#2563eb,#3b82f6);
        color: #fff;
        border: none;
        border-radius: 9px;
        padding: 7px 14px;
        font-size: .78rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all .18s;
    }

        .btn-add:hover {
            opacity: .9;
            transform: translateY(-1px);
        }

    .btn-save {
        background: linear-gradient(135deg,#059669,#10b981);
        color: #fff;
        border: none;
        border-radius: 9px;
        padding: 9px 20px;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 3rem;
            color: #e2e8f0;
            display: block;
            margin-bottom: 12px;
        }

        .empty-state h5 {
            color: #64748b;
            font-size: .9rem;
            margin: 0 0 6px;
        }
</style>

<div class="page-wrapper">

    <div class="page-header">
        <div style="display:flex;align-items:center;gap:12px;">
            <div class="nav-icon-box"><i class="bi bi-building"></i></div>
            <div>
                <h1 style="font-size:1.05rem;font-weight:800;color:var(--dark-1);margin:0 0 2px;">دابینکەران</h1>
                <p style="font-size:.75rem;color:#64748b;margin:0;">بەڕێوەبردنی کۆمپانیا و دابینکەرەکان</p>
            </div>
        </div>
        <button type="button" class="btn-add" onclick="openAdd()">
            <i class="bi bi-plus-lg"></i> دابینکەری نوێ
        </button>
    </div>

    <div class="card">
        <div class="card-head">
            <span style="font-size:.82rem;font-weight:700;color:var(--dark-1);display:flex;align-items:center;gap:7px;">
                <i class="bi bi-people-fill" style="color:var(--info);"></i>
                <span id="supplierCount">@Model.SupplierList.Count دابینکەر</span>
            </span>
            <div class="search-wrap">
                <input type="text" id="searchInp" class="search-inp" placeholder="گەڕان بە ناو یان تەلەفۆن..." oninput="filterTable()">
                <i class="bi bi-search"></i>
            </div>
        </div>

        @if (Model.SupplierList.Any())
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width:5%;text-align:center;">#</th>
                        <th>ناوی دابینکەر</th>
                        <th style="width:16%;">تەلەفۆن</th>
                        <th>ناونیشان</th>
                        <th style="width:11%;text-align:center;">پسوڵەکان</th>
                        <th style="width:10%;text-align:center;">دۆخ</th>
                        <th style="width:9%;text-align:center;">کردار</th>
                    </tr>
                </thead>
                <tbody id="supplierTbody">
                    @{
                        int rn = 1;
                    }
                    @foreach (var s in Model.SupplierList)
                    {
                        var isDefault = s.SupplierId == 1;
                        <tr data-name="@s.Name.ToLower()" data-phone="@(s.Phone?.ToLower() ?? "")">
                            <td style="text-align:center;color:#94a3b8;font-size:.7rem;font-weight:600;">@rn</td>
                            <td>
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <div style="width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,#dbeafe,#eff6ff);color:#2563eb;display:flex;align-items:center;justify-content:center;font-size:.75rem;flex-shrink:0;">
                                        <i class="bi bi-@(isDefault ? "question-circle" : "building")"></i>
                                    </div>
                                    <span style="font-weight:@(isDefault ? "500" : "700");font-size:.8rem;color:@(isDefault ? "#94a3b8" : "var(--dark-1)");">@s.Name</span>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.Phone))
                                {
                                    <span style="font-family:monospace;font-size:.77rem;display:flex;align-items:center;gap:5px;">
                                        <i class="bi bi-telephone" style="color:#94a3b8;font-size:.65rem;"></i>@s.Phone
                                    </span>
                                }
                                else
                                {
                                    <span style="color:#cbd5e1;font-size:.7rem;">&#8212;</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.Address))
                                {
                                    <span style="color:#64748b;font-size:.74rem;display:flex;align-items:center;gap:5px;" title="@s.Address">
                                        <i class="bi bi-geo-alt" style="color:#94a3b8;font-size:.65rem;flex-shrink:0;"></i>
                                        <span style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block;">@s.Address</span>
                                    </span>
                                }
                                else
                                {
                                    <span style="color:#cbd5e1;font-size:.7rem;">&#8212;</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                @if (isDefault)
                                {
                                    <span class="badge-default">@s.PurchaseCount پسوڵە</span>
                                }
                                else
                                {
                                    <span class="badge-count">@s.PurchaseCount پسوڵە</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                @if (s.IsActive)
                                {
                                    <span class="badge-active">چالاک</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">ناچالاک</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                <div style="display:flex;gap:5px;justify-content:center;">
                                    @if (isDefault)
                                    {
                                        <button class="action-btn edit" disabled title="ناگەڕێتەوە"><i class="bi bi-lock"></i></button>
                                        <button class="action-btn delete" disabled title="ناگەڕێتەوە"><i class="bi bi-lock"></i></button>
                                    }
                                    else
                                    {
                                        <button type="button" class="action-btn edit" onclick="openEdit(@s.SupplierId)" title="دەستکاری"><i class="bi bi-pencil"></i></button>
                                        <button type="button" class="action-btn delete" onclick="openDelete(@s.SupplierId, '@s.Name.Replace("'", "\\'")')" title="سڕینەوە"><i class="bi bi-trash"></i></button>
                                    }
                                </div>
                            </td>
                        </tr>
                        rn++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-building"></i>
                <h5>هیچ دابینکەرێک نییە</h5>
            </div>
        }
    </div>
</div>

<!-- مۆدالی زیادکردن -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <div class="modal-header blue">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> دابینکەری نوێ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="pf-wrap">
                    <input type="text" id="addName" placeholder=" " maxlength="200">
                    <label>ناوی دابینکەر *</label>
                </div>
                <div class="pf-wrap">
                    <input type="text" id="addPhone" placeholder=" " maxlength="50">
                    <label>تەلەفۆن (ئارەزوومەندانە)</label>
                </div>
                <div class="pf-wrap" style="margin-bottom:6px;">
                    <textarea id="addAddress" rows="2" placeholder=" " maxlength="300"></textarea>
                    <label>ناونیشان (ئارەزوومەندانە)</label>
                </div>
                <div id="addMsg" style="font-size:.73rem;min-height:16px;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">داخستن</button>
                <button type="button" class="btn-save" onclick="saveAdd()"><i class="bi bi-check-lg"></i> پاشەکەوتکردن</button>
            </div>
        </div>
    </div>
</div>

<!-- مۆدالی دەستکاری -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <div class="modal-header warning">
                <h5 class="modal-title"><i class="bi bi-pencil-square"></i> دەستکاری دابینکەر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId">
                <div class="pf-wrap">
                    <input type="text" id="editName" placeholder=" " maxlength="200">
                    <label>ناوی دابینکەر *</label>
                </div>
                <div class="pf-wrap">
                    <input type="text" id="editPhone" placeholder=" " maxlength="50">
                    <label>تەلەفۆن</label>
                </div>
                <div class="pf-wrap" style="margin-bottom:10px;">
                    <textarea id="editAddress" rows="2" placeholder=" " maxlength="300"></textarea>
                    <label>ناونیشان</label>
                </div>
                <label style="display:flex;align-items:center;gap:8px;font-size:.78rem;cursor:pointer;">
                    <input type="checkbox" id="editActive" style="width:16px;height:16px;accent-color:var(--info);">
                    <span>چالاک</span>
                </label>
                <div id="editMsg" style="font-size:.73rem;min-height:16px;margin-top:6px;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">داخستن</button>
                <button type="button" class="btn-save" onclick="saveEdit()"><i class="bi bi-check-lg"></i> پاشەکەوتکردن</button>
            </div>
        </div>
    </div>
</div>

<!-- مۆدالی سڕینەوە -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
        <div class="modal-content">
            <div class="modal-header danger">
                <h5 class="modal-title"><i class="bi bi-trash"></i> سڕینەوەی دابینکەر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="text-align:center;padding:24px 20px;">
                <i class="bi bi-exclamation-triangle-fill" style="font-size:2.5rem;color:var(--warning);display:block;margin-bottom:12px;"></i>
                <p style="font-size:.85rem;font-weight:600;color:var(--dark-1);margin-bottom:6px;">
                    دابینکەر <span id="deleteSupplierName" style="color:#dc2626;"></span> دەسڕێیتەوە؟
                </p>
                <p style="font-size:.75rem;color:#64748b;margin:0;">پسوڵەکانی پێوەندیدار دەگەڕێنرێنەوە بۆ "دیارینەکراو".</p>
                <input type="hidden" id="deleteId">
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">نەخێر</button>
                <button type="button" class="btn btn-danger px-4 fw-bold" onclick="confirmDelete()">
                    <i class="bi bi-trash me-1"></i>بەڵێ، بسڕەوە
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const tok = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

        function showMsg(id, txt, ok) {
            const el = document.getElementById(id);
            if (el) el.innerHTML = '<span style="color:' + (ok ? '#16a34a' : '#dc2626') + '">' + txt + '</span>';
        }

        function filterTable() {
            const q = (document.getElementById('searchInp').value || '').toLowerCase();
            let count = 0;
            document.querySelectorAll('#supplierTbody tr').forEach(function(tr) {
                const ok = !q || (tr.dataset.name || '').includes(q) || (tr.dataset.phone || '').includes(q);
                tr.style.display = ok ? '' : 'none';
                if (ok) count++;
            });
            document.getElementById('supplierCount').textContent = count + ' دابینکەر';
        }

        function openAdd() {
            ['addName', 'addPhone', 'addAddress'].forEach(function(id) {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });
            document.getElementById('addMsg').innerHTML = '';
            new bootstrap.Modal(document.getElementById('addModal')).show();
            setTimeout(function() { document.getElementById('addName').focus(); }, 200);
        }

        async function saveAdd() {
            const name = (document.getElementById('addName').value || '').trim();
            if (!name) { showMsg('addMsg', 'ناوی دابینکەر پێویستە', false); return; }
            const fd = new FormData();
            fd.append('SupplierInput.Name',    name);
            fd.append('SupplierInput.Phone',   (document.getElementById('addPhone').value || '').trim());
            fd.append('SupplierInput.Address', (document.getElementById('addAddress').value || '').trim());
            fd.append('__RequestVerificationToken', tok());
            try {
                const r = await fetch('?handler=Add', { method: 'POST', body: fd });
                const d = await r.json();
                if (d.success) location.reload();
                else showMsg('addMsg', d.message || 'هەڵە', false);
            } catch(e) { showMsg('addMsg', 'هەڵەی پەیوەندی', false); }
        }

        async function openEdit(id) {
            const r = await fetch('?handler=Get&id=' + id);
            const d = await r.json();
            if (!d.success) return;
            document.getElementById('editId').value      = d.supplierId;
            document.getElementById('editName').value    = d.name;
            document.getElementById('editPhone').value   = d.phone || '';
            document.getElementById('editAddress').value = d.address || '';
            document.getElementById('editActive').checked = d.isActive;
            document.getElementById('editMsg').innerHTML = '';
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }

        async function saveEdit() {
            const name = (document.getElementById('editName').value || '').trim();
            if (!name) { showMsg('editMsg', 'ناوی دابینکەر پێویستە', false); return; }
            const fd = new FormData();
            fd.append('SupplierInput.SupplierId', document.getElementById('editId').value);
            fd.append('SupplierInput.Name',       name);
            fd.append('SupplierInput.Phone',      (document.getElementById('editPhone').value || '').trim());
            fd.append('SupplierInput.Address',    (document.getElementById('editAddress').value || '').trim());
            fd.append('SupplierInput.IsActive',   document.getElementById('editActive').checked);
            fd.append('__RequestVerificationToken', tok());
            try {
                const r = await fetch('?handler=Edit', { method: 'POST', body: fd });
                const d = await r.json();
                if (d.success) location.reload();
                else showMsg('editMsg', d.message || 'هەڵە', false);
            } catch(e) { showMsg('editMsg', 'هەڵەی پەیوەندی', false); }
        }

        function openDelete(id, name) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteSupplierName').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        async function confirmDelete() {
            const fd = new FormData();
            fd.append('DeleteSupplierId', document.getElementById('deleteId').value);
            fd.append('__RequestVerificationToken', tok());
            try {
                const r = await fetch('?handler=Delete', { method: 'POST', body: fd });
                const d = await r.json();
                if (d.success) location.reload();
                else alert(d.message || 'هەڵە');
            } catch(e) { alert('هەڵەی پەیوەندی'); }
        }
    </script>
}
