            h += tblClone.outerHTML;

            h += '\x3Cdiv class="footer"\x3Eسوپاس بۆ مامەڵەکردن لەگەڵمان\x3C/div\x3E';
            h += '\x3C/body\x3E\x3C/html\x3E';

            var printWin = window.open('', '_blank');
            if (printWin) {
                printWin.document.open();
                printWin.document.write(h);
                printWin.document.close();
                setTimeout(function() { printWin.focus(); printWin.print(); }, 800);
            } else {
                alert('تکایە ڕێگە بدە بە کرانەوەی پەنجەرەی نوێ (Pop-up blocker)');
            }
        }
    </script>
}