@section Scripts {
    <script>
        // ══ گەڕانی خۆکار بێ ڕیفڕێشکردنی پەڕەکە (AJAX Search) ══
        let searchTimeout = null;

        async function performSearch() {
            // گۆڕینی شێوازی دروستکردنی لینکەکە بۆ ئەوەی زۆر پارێزراو بێت
            const searchInput = document.getElementById('searchInput');
            const roleSelect = document.querySelector('select[name="roleFilter"]');

            const searchTerm = searchInput ? searchInput.value.trim() : '';
            const roleFilter = roleSelect ? roleSelect.value : '';

            // بەکارهێنانی لینکی ئێستای پەڕەکە بە هەموو کوێریەکانییەوە وەکو بنەما
            const url = new URL(window.location.href);

            if (searchTerm) {
                url.searchParams.set('searchTerm', searchTerm);
            } else {
                url.searchParams.delete('searchTerm');
            }

            if (roleFilter) {
                url.searchParams.set('roleFilter', roleFilter);
            } else {
                url.searchParams.delete('roleFilter');
            }

            // کەمێک کاڵکردنەوەی خشتەکە بۆ هەستکردن بە گەڕان
            const tblScroll = document.querySelector('.db-tbl-scroll');
            if(tblScroll) tblScroll.style.opacity = '0.5';

            try {
                // ناردنی داواکارییەکە
                const response = await fetch(url.toString(), {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) throw new Error('Network Error');

                const html = await response.text();

                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');

                // نوێکردنەوەی خشتەکە
                const newTblScroll = doc.querySelector('.db-tbl-scroll');
                if (newTblScroll && tblScroll) {
                    tblScroll.innerHTML = newTblScroll.innerHTML;
                }

                // نوێکردنەوەی ئامارەکان
                const newStats = doc.querySelector('.db-stats');
                const currentStats = document.querySelector('.db-stats');
                if (newStats && currentStats) {
                    currentStats.innerHTML = newStats.innerHTML;
                }

                // نوێکردنەوەی فوتەر
                const newFoot = doc.querySelector('.us-foot');
                const currentFoot = document.querySelector('.us-foot');
                const dbCard = document.querySelector('.db-card');
                if (currentFoot) currentFoot.remove();
                if (newFoot && dbCard) dbCard.appendChild(newFoot);

                // گۆڕینی لینکی سەرەوە بەبێ ڕیفڕێش
                window.history.replaceState({}, '', url.toString());
            } catch (e) {
                console.error('هەڵە لە گەڕاندا:', e);
            } finally {
                if(tblScroll) tblScroll.style.opacity = '1';
            }
        }

        function autoSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                performSearch();
            }, 300); // لە دوای 300 میلی چرکە لە وەستانی دەستت گەڕانەکە ئەنجام دەدرێت
        }

        // ══ پێشبینینی وێنە ══
        function previewAvatar(input, previewId, imageUrl = null) {
            const preview = document.getElementById(previewId);
            if (!preview) return;

            if (imageUrl) {
                preview.innerHTML = `<img src="${imageUrl}" alt="avatar" style="width:100%;height:100%;object-fit:cover;">`;
                return;
            }

            const file = input?.files?.[0];
            if (!file) {
                preview.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:20px;height:20px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
                return;
            }

            const reader = new FileReader();
            reader.onload = e => preview.innerHTML = `<img src="${e.target.result}" alt="avatar" style="width:100%;height:100%;object-fit:cover;">`;
            reader.readAsDataURL(file);
        }

        // ── داشکاندن: شاردن/پیشاندان ──
        function toggleDiscount(selectId, wrapId) {
            const role = document.getElementById(selectId).value;
            const wrap = document.getElementById(wrapId);
            if(role === 'Admin'){
                wrap.style.opacity = '0.5';
                wrap.style.pointerEvents = 'none';
                wrap.querySelector('input').value = '0';
            } else {
                wrap.style.opacity = '1';
                wrap.style.pointerEvents = 'auto';
            }
        }

        // ── مۆدالی زیادکردن ──
        function openAddModal() {
            ['addUserName','addEmail','addPassword'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('addProfileImage').value = '';
            previewAvatar(null, 'addAvatarPreview');
            document.getElementById('addRole').value = 'Cashier';
            document.getElementById('addMaxDiscount').value = '5';
            toggleDiscount('addRole', 'addDiscountWrap');
            new bootstrap.Modal(document.getElementById('addModal')).show();
            setTimeout(() => document.getElementById('addUserName').focus(), 300);
        }

        async function addUser() {
            const userName    = document.getElementById('addUserName').value.trim();
            const email       = document.getElementById('addEmail').value.trim();
            const password    = document.getElementById('addPassword').value;
            const role        = document.getElementById('addRole').value;
            const maxDiscount = document.getElementById('addMaxDiscount').value || 0;

            if (!userName) { alert('ناو بنووسە'); return; }
            if (!email)    { alert('ئیمەیڵ بنووسە'); return; }
            if (!password) { alert('پاسۆرد بنووسە'); return; }

            const fd = new FormData();
            fd.append('userName', userName); fd.append('email', email);
            fd.append('password', password); fd.append('role', role);
            fd.append('maxDiscount', maxDiscount);
            const addImage = document.getElementById('addProfileImage').files[0];
            if (addImage) fd.append('profileImage', addImage);
            fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const r = await fetch('?handler=AddUser', { method:'POST', body:fd });
                const d = await r.json();
                if (d.success) location.reload(); else alert(d.message);
            } catch(e) { alert('هەڵە: ' + e); }
        }

        // ── مۆدالی دەستکاری ──
        async function openEditModal(id) {
            try {
                const r = await fetch(`?handler=User&id=${id}`);
                const d = await r.json();
                if (!d.success) return;

                document.getElementById('editId').value            = d.user.id;
                document.getElementById('editUserName').value      = d.user.userName;
                document.getElementById('editEmail').value         = d.user.email;
                document.getElementById('editPassword').value      = '';
                document.getElementById('editRole').value          = d.user.role;
                document.getElementById('editMaxDiscount').value   = d.user.maxDiscount;
                document.getElementById('editProfileImage').value  = '';
                document.getElementById('removeEditProfileImage').checked = false;
                document.getElementById('editCurrentImagePath').value = d.user.profileImagePath || '';

                previewAvatar(null, 'editAvatarPreview', d.user.profileImagePath || null);
                toggleDiscount('editRole', 'editDiscountWrap');
                new bootstrap.Modal(document.getElementById('editModal')).show();
            } catch(e) { alert('هەڵە: ' + e); }
        }

        async function updateUser() {
            const fd = new FormData();
            fd.append('id',          document.getElementById('editId').value);
            fd.append('userName',    document.getElementById('editUserName').value);
            fd.append('email',       document.getElementById('editEmail').value);
            fd.append('password',    document.getElementById('editPassword').value);
            fd.append('role',        document.getElementById('editRole').value);
            fd.append('maxDiscount', document.getElementById('editMaxDiscount').value || 0);
            fd.append('removeProfileImage', document.getElementById('removeEditProfileImage').checked);

            const editImage = document.getElementById('editProfileImage').files[0];
            if (editImage) fd.append('profileImage', editImage);
            fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const r = await fetch('?handler=UpdateUser', { method:'POST', body:fd });
                const d = await r.json();
                if (d.success) location.reload(); else alert(d.message);
            } catch(e) { alert('هەڵە: ' + e); }
        }

        // ── قفڵکردن/کردنەوە ──
        async function toggleLock(id) {
            if (!confirm('دڵنیایت لە گۆڕینی دۆخ؟')) return;
            const fd = new FormData();
            fd.append('id', id);
            fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
            try {
                const r = await fetch('?handler=ToggleLock', { method:'POST', body:fd });
                const d = await r.json();
                if (d.success) location.reload(); else alert(d.message);
            } catch(e) { alert('هەڵە: ' + e); }
        }

        // ── سڕینەوە ──
        function deleteUser(id, name) {
            document.getElementById('deleteId').value            = id;
            document.getElementById('deleteUserName').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        async function confirmDelete() {
            const fd = new FormData();
            fd.append('id', document.getElementById('deleteId').value);
            fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
            try {
                const r = await fetch('?handler=DeleteUser', { method:'POST', body:fd });
                const d = await r.json();
                if (d.success) location.reload(); else alert(d.message);
            } catch(e) { alert('هەڵە: ' + e); }
        }

        document.getElementById('addModal')?.addEventListener('keypress',  e => { if(e.key==='Enter'){e.preventDefault();addUser();} });
        document.getElementById('editModal')?.addEventListener('keypress', e => { if(e.key==='Enter'){e.preventDefault();updateUser();} });
    </script>
}