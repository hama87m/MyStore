@section Scripts {
    <script>
        // ══ هەموو JavaScript ـی ئۆریجیناڵ — بەبێ هیچ گۆڕانکارییەک ══
        const $  = id => document.getElementById(id);
        const fmt = n  => Number(n||0).toLocaleString('en-US',{maximumFractionDigits:0});

        let items = [];
        const PD  = {};
        @foreach (var p in Model.ProductsForPurchase)
        {
                @:PD[@p.ProductId] = { name:'@Html.Raw(p.Name.Replace("'", "\\'"))', barcode:'@Html.Raw((p.Barcode ?? "").Replace("'", "\\'"))', sale:@p.SalePrice, stock:@p.CurrentStock, carton:@p.QtyPerCarton, dozen:@p.QtyPerDozen, bundle:@p.QtyPerBundle };
        }

        // ═══════════════════════════════════════════════════════
        // فلتەری ناوخۆیی درۆپداونەکەی کاڵا بەبێ سێرڤەر
        // ═══════════════════════════════════════════════════════
        let allProductOptions = [];
        document.addEventListener("DOMContentLoaded", function() {
            var sel = $('productSelect');
            if(sel) {
                // هەموو ئۆپشنەکان خەزن دەکەین جگە لە یەکەم دانەیان (پێشنیارکراو)
                for(var i = 1; i < sel.options.length; i++) {
                    allProductOptions.push(sel.options[i]);
                }
            }
        });

        function filterLocalProducts() {
            var input = $('localSearchInput');
            if (!input) return;
            var filter = input.value.toLowerCase();
            var select = $('productSelect');
            var firstOpt = select.options[0]; // هێشتنەوەی کاڵا هەڵبژێرە

            // سڕینەوەی هەموویان لە سەلێکتەکە
            while (select.options.length > 1) {
                select.remove(1);
            }

            // دانانەوەی ئەوانەی لەگەڵ گەڕانەکە دەگونجێن
            allProductOptions.forEach(function(opt) {
                if (opt.text.toLowerCase().indexOf(filter) > -1) {
                    select.appendChild(opt);
                }
            });
        }
        // ═══════════════════════════════════════════════════════

        function profitPill(cost, sale) {
            if (!cost||cost<=0||sale<=0) return '<span class="pm-pill z">—</span>';
            const d=sale-cost, p=((d/cost)*100).toFixed(0);
            if(d>0) return `<span class="pm-pill g"><i class="bi bi-arrow-up-short"></i>${fmt(d)} (${p}%)</span>`;
            if(d<0) return `<span class="pm-pill l"><i class="bi bi-arrow-down-short"></i>${fmt(Math.abs(d))} (${Math.abs(p)}%)</span>`;
            return '<span class="pm-pill z">سەربەسەر</span>';
        }

        let activeRowIdx = -1;
        function getUnitLabel(it) {
            if(it.unit===1) return 'دانە';
            if(it.unit===it.carton) return `کارتۆن(${it.carton})`;
            if(it.unit===it.dozen)  return `دەرزەن(${it.dozen})`;
            if(it.unit===it.bundle) return `بەستە(${it.bundle})`;
            return `×${it.unit}`;
        }

        function renderItems() {
            const box = $('itemsContainer');
            if (!items.length) {
                activeRowIdx = -1;
                box.innerHTML = '<div class="pm-empty"><i class="bi bi-basket3"></i><p>هێشتا کاڵایەک زیادنەکراوە</p></div>';
                updTotals(0,0,0); return;
            }
            let total=0, profit=0;
            let html = `<table class="pm-tbl"><thead><tr>
                <th style="width:24px;">#</th><th>ناو</th><th>باڕکۆد</th><th>یەکە</th><th>بڕ</th><th>تێچووی دانە</th><th>کۆی تێچوو</th><th style="width:34px;">کردار</th>
            </tr></thead><tbody>`;

            items.forEach((it,i) => {
                const rq  = it.qty * it.unit;
                const c1  = it.unit>1 ? it.price/it.unit : it.price;
                const sub = rq * c1;
                const isL = it.sale>0 && it.sale < c1;
                total  += sub;
                profit += (it.sale>0 ? it.sale-c1 : 0) * rq;
                const pd = PD[it.productId]||{};
                const barcode = pd.barcode || it.barcode || '—';
                const rowCls  = (i===activeRowIdx) ? ' class="active-row"' : (isL ? ' class="loss-row"' : '');
                const costStyle = isL ? 'color:var(--danger);font-weight:700;' : 'font-weight:700 regular;';

                html += `<tr${rowCls} onclick="loadItemToForm(${i})" title="کلیک بکە بۆ دەستکاری">
                    <td class="td-idx">${i+1}</td>
                    <td class="td-name" title="${it.name}">${it.name}</td>
                    <td class="td-barcode">${barcode}</td>
                    <td class="td-unit">${getUnitLabel(it)}</td>
                    <td class="td-num">${it.qty}</td>
                    <td style="${costStyle}">${fmt(c1)}</td>
                    <td class="td-total">${fmt(sub)}</td>
                    <td><button class="btn-del-row" onclick="event.stopPropagation();removeItem(${i})" title="سڕینەوە"><i class="bi bi-trash3"></i></button></td>
                </tr>`;
            });
            html += `</tbody></table>`;
            box.innerHTML = html;
            updTotals(total, items.length, profit);
        }

        function updTotals(total, count, profit) {
            ['totalDisplay','mfTotal'].forEach(id=>{ const e=$(id); if(e) e.textContent=fmt(total); });
            ['mfItemCount'].forEach(id=>{ const e=$(id); if(e) e.textContent=count; });
            const eBadge=$('itemCountDisplay'); if(eBadge){ eBadge.textContent=count; eBadge.style.display=count>0?'inline':'none'; }
            ['mfProfit'].forEach(id=>{ const e=$(id); if(!e) return; e.textContent=fmt(profit); });
            const eTypes=$('statItemTypes');  if(eTypes) eTypes.textContent=count;
            const eTotal=$('statTotal');      if(eTotal) eTotal.textContent=fmt(total);
            const eProfit=$('statProfit');
            if(eProfit){
                const totalQty = items.reduce((s,it)=>s+(it.qty*(it.unit||1)),0);
                $('statTotalQty').textContent = totalQty;
                eProfit.textContent = fmt(profit);
                eProfit.style.color = profit>0?'var(--success)':profit<0?'var(--danger)':'var(--text-dim)';
            }
        }

        function addItem(p) {
            const ex=items.find(x=>x.productId===p.productId);
            if(ex){ ex.qty++; renderItems(); return; }
            const pd=PD[p.productId]||{};
            items.push({ productId:p.productId, name:p.name||pd.name, barcode:p.barcode||pd.barcode||'', price:p.unitPrice||0, qty:1, unit:1,
                carton:p.qtyPerCarton||pd.carton||1, dozen:p.qtyPerDozen||pd.dozen||1, bundle:p.qtyPerBundle||pd.bundle||1,
                stock:p.currentStock||pd.stock||0, sale:p.salePrice||pd.sale||0 });
            renderItems();
        }
        const removeItem = i => { items.splice(i,1); renderItems(); };

        $('barcodeInput')?.addEventListener('keypress', e=>{ if(e.key==='Enter'){e.preventDefault();findProduct();}});
        async function findProduct() {
            const val=$('barcodeInput').value.trim(); if(!val) return;
            showMsg('<i class="bi bi-arrow-repeat"></i>...','inf');
            try {
                const fd=new FormData();
                fd.append('barcode',val);
                fd.append('__RequestVerificationToken',document.querySelector('input[name="__RequestVerificationToken"]').value);
                const r=await fetch('?handler=Barcode',{method:'POST',body:fd}), d=await r.json();
                if(d.success){
                    const sel=$('productSelect');
                    const opt=Array.from(sel.options).find(o=>o.value==d.product.productId);
                    if(opt){ sel.value=d.product.productId; onProductSelect(); showMsg('<i class="bi bi-check-circle-fill"></i> '+d.product.name+' دۆزرایەوە','ok'); }
                    else {
                        const o=new Option(d.product.name+' (ستۆک: '+(d.product.currentStock||0)+')', d.product.productId);
                        o.dataset.name=d.product.name; o.dataset.stock=d.product.currentStock||0;
                        o.dataset.sale=d.product.salePrice||0; o.dataset.wholesale=d.product.wholesalePrice||0;
                        o.dataset.carton=d.product.qtyPerCarton||1; o.dataset.dozen=d.product.qtyPerDozen||1; o.dataset.bundle=d.product.qtyPerBundle||1;
                        sel.appendChild(o); sel.value=d.product.productId; onProductSelect();
                        
                        allProductOptions.push(o); // زیادکرا بۆ ئەوەی بە فلتەر بدۆزرێتەوە ئەگەر نوێیە

                        showMsg('<i class="bi bi-check-circle-fill"></i> '+d.product.name+' دۆزرایەوە','ok');
                    }
                    $('barcodeInput').value='';
                } else showMsg('<i class="bi bi-x-circle-fill"></i> '+d.message,'err');
            } catch(e){ showMsg('<i class="bi bi-x-circle-fill"></i> هەڵە','err'); }
            setTimeout(()=>{ const m=$('searchMessage'); if(m) m.innerHTML=''; },3000);
            $('barcodeInput').focus();
        }
        function showMsg(txt,type) {
            const m=$('searchMessage'); if(!m) return;
            const cls=type==='ok'?'pm-msg-ok':type==='err'?'pm-msg-err':'pm-msg-inf';
            m.innerHTML=`<div class="${cls}">${txt}</div>`;
        }

        let priceMode = 'unit';
        function setPriceMode(mode) {
            priceMode = mode;
            const b1=$('priceToggle1'), b2=$('priceToggle2'), lbl=$('priceLabel');
            if(mode==='unit'){ b1.style.cssText='flex:1;height:26px;border:none;padding:0;font-size:11px;font-weight:600;cursor:pointer;background:linear-gradient(135deg,#6366f1,#818cf8);color:#fff;font-family:inherit;'; b2.style.cssText='flex:1;height:26px;border:none;padding:0;font-size:11px;font-weight:600;cursor:pointer;background:var(--pu-input);color:var(--accent);font-family:inherit;'; if(lbl) lbl.textContent='نرخی ١ یەکە'; }
            else { b2.style.cssText='flex:1;height:26px;border:none;padding:0;font-size:11px;font-weight:600;cursor:pointer;background:linear-gradient(135deg,#6366f1,#818cf8);color:#fff;font-family:inherit;'; b1.style.cssText='flex:1;height:26px;border:none;padding:0;font-size:11px;font-weight:600;cursor:pointer;background:var(--pu-input);color:var(--accent);font-family:inherit;'; if(lbl) lbl.textContent='کۆی گشتی'; }
            updateBuyPreview();
        }

        function clearProductForm() {
            $('stockChip').style.display='none';
            $('salePriceShow').value=''; $('wholesalePriceShow').value='';
            $('priceInfoRow').style.display='none';
            $('selectUnit').innerHTML='<option value="1">دانە</option>';
            $('selectQty').value='1'; $('selectPrice').value='';
            hidePB(); $('unitCostRow').style.display='none';
            const wrap=$('buyPriceWrap'); if(wrap) wrap.classList.remove('loss');
        }

        function onProductSelect() {
            const sel=$('productSelect'), opt=sel.selectedOptions[0];
            if(!opt?.value){ clearProductForm(); return; }
            const cr=parseInt(opt.dataset.carton)||1, dz=parseInt(opt.dataset.dozen)||1, bn=parseInt(opt.dataset.bundle)||1;
            let uH='<option value="1">دانە</option>';
            if(cr>1) uH+=`<option value="${cr}">کارتۆن (${cr})</option>`;
            if(dz>1) uH+=`<option value="${dz}">دەرزەن (${dz})</option>`;
            if(bn>1) uH+=`<option value="${bn}">بەستە (${bn})</option>`;
            $('selectUnit').innerHTML=uH;
            const st=parseInt(opt.dataset.stock)||0;
            const chip=$('stockChip'); chip.style.display='flex';
            const num=$('stockChipNum'); num.textContent=st;
            num.className='num'+(st<=0?' out':st<5?' low':'');
            const saleP = parseFloat(opt.dataset.sale)||0;
            const pd    = PD[parseInt(opt.value)]||{};
            const wsP   = pd.wholesale||0;
            $('salePriceShow').value = saleP;
            $('wholesalePriceShow').value = wsP;
            $('salePriceDisplay').textContent  = saleP>0 ? fmt(saleP) : '—';
            $('wholesalePriceDisplay').textContent = wsP>0 ? fmt(wsP) : '—';
            $('priceInfoRow').style.display = (saleP>0||wsP>0) ? 'block' : 'none';
            updateBuyPreview();
        }

        function onUnitChange(){ updateBuyPreview(); }

        function syncPurchaseDateTime(){
            const dEl=$('purchaseDateOnly'), tEl=$('purchaseTime'), hEl=$('purchaseDate');
            if(!dEl||!tEl||!hEl) return;
            const now=new Date(), _pad=n=>String(n).padStart(2,'0');
            const todayStr=`${now.getFullYear()}-${_pad(now.getMonth()+1)}-${_pad(now.getDate())}`;
            dEl.max=todayStr;
            if(dEl.value>todayStr) dEl.value=todayStr;
            if(dEl.value===todayStr){
                const maxT=`${_pad(now.getHours())}:${_pad(now.getMinutes())}`;
                tEl.max=maxT; if(tEl.value>maxT) tEl.value=maxT;
            } else { tEl.max=''; }
            const timeVal=tEl.value||`${_pad(now.getHours())}:${_pad(now.getMinutes())}`;
            hEl.value=`${dEl.value||todayStr}T${timeVal}:00`;
        }

        function updateBuyPreview() {
            const rawPrice = parseFloat($('selectPrice')?.value)||0;
            const qty      = parseInt($('selectQty')?.value)||1;
            const unit     = parseInt($('selectUnit')?.value)||1;
            const sale     = parseFloat($('salePriceShow')?.value)||0;
            const wrap     = $('buyPriceWrap');
            let unitCost = 0;
            if(rawPrice>0){
                if(priceMode==='total'){ const totalUnits = qty * unit; unitCost = totalUnits>0 ? rawPrice/totalUnits : 0; }
                else { unitCost = unit>1 ? rawPrice/unit : rawPrice; }
            }
            const ucRow=$('unitCostRow'), ucCalc=$('unitCostCalc');
            if(unit>1 && rawPrice>0){ ucRow.style.display='block'; ucCalc.textContent = fmt(unitCost); } else { ucRow.style.display='none'; }
            if(!rawPrice||!sale){ hidePB(); if(wrap) wrap.classList.remove('loss'); return; }
            const diff=sale-unitCost, pct=((diff/unitCost)*100).toFixed(0);
            const bar=$('profitBar'), txt=$('profitBarText'), pe=$('profitBarPct');
            if(!bar) return;
            if(diff<0){ bar.className='pm-profit-bar loss'; txt.innerHTML=`<i class="bi bi-exclamation-triangle-fill me-1"></i>زەرەر: ${fmt(Math.abs(diff))}`; pe.textContent=`${Math.abs(pct)}%`; if(wrap) wrap.classList.add('loss'); }
            else if(diff===0){ bar.className='pm-profit-bar zero'; txt.textContent='سەربەسەر'; pe.textContent='0%'; if(wrap) wrap.classList.remove('loss'); }
            else { bar.className='pm-profit-bar gain'; txt.innerHTML=`<i class="bi bi-arrow-up-circle-fill me-1"></i>قازانج: ${fmt(diff)}`; pe.textContent=`${pct}%`; if(wrap) wrap.classList.remove('loss'); }
        }
        function hidePB(){ const b=$('profitBar'); if(b) b.className='pm-profit-bar hidden'; }

        function addFromSelect() {
            const sel=$('productSelect'), opt=sel.selectedOptions[0];
            if(!opt?.value){ showMsg('<i class="bi bi-x-circle-fill"></i> هەڵبژێرە','err'); return; }
            const rawPrice=parseFloat($('selectPrice').value)||0;
            if(rawPrice<=0){ showMsg('<i class="bi bi-x-circle-fill"></i> تێچوو بنووسە','err'); return; }
            const qty=parseInt($('selectQty').value)||1;
            const unit=parseInt($('selectUnit').value)||1;
            const id=parseInt(opt.value);
            let unitCost;
            if(priceMode==='total'){ const totalUnits = qty * unit; unitCost = totalUnits>0 ? rawPrice/totalUnits : rawPrice; }
            else { unitCost = unit>1 ? rawPrice/unit : rawPrice; }
            const ex=items.find(x=>x.productId===id);
            if(ex){ ex.qty=qty; ex.price=unitCost*unit; ex.unit=unit; }
            else { const _pd=PD[id]||{}; items.push({ productId:id, name:opt.dataset.name, barcode:_pd.barcode||'', price:unitCost*unit, qty, unit,
                carton:parseInt(opt.dataset.carton)||1, dozen:parseInt(opt.dataset.dozen)||1, bundle:parseInt(opt.dataset.bundle)||1,
                stock:parseInt(opt.dataset.stock)||0, sale:parseFloat(opt.dataset.sale)||0 }); }
            renderItems();
            activeRowIdx = -1;
            clearProductForm(); sel.value='';
            showMsg('<i class="bi bi-check-circle-fill"></i> زیادکرا','ok');
        }

        function loadItemToForm(idx) {
            const it=items[idx]; if(!it) return;
            activeRowIdx = idx;
            const sel=$('productSelect'); sel.value=it.productId; onProductSelect();
            setTimeout(()=>{
                $('selectUnit').value=it.unit; $('selectQty').value=it.qty;
                $('selectPrice').value=it.price;
                priceMode='unit'; setPriceMode('unit'); updateBuyPreview();
            }, 30);
            renderItems();
        }

        // مۆدالی کاڵای نوێ
        function openNewProductModal() { $('newProductModal').style.display='flex'; $('npBackdrop').style.display='block'; setTimeout(()=>$('newProdName')?.focus(),80); }
        function closeNewProductModal() { $('newProductModal').style.display='none'; $('npBackdrop').style.display='none'; }
        $('npBackdrop')?.addEventListener('click',closeNewProductModal);

        function updateNewProfit() {
            const buy=parseFloat($('newProdBuyPrice')?.value)||0, sale=parseFloat($('newProdSalePrice')?.value)||0;
            const bar=$('newProfitBar'), txt=$('newProfitText'), pct=$('newProfitPct'), wrap=$('newBuyWrap');
            if(!buy||!sale){ if(bar) bar.className='pm-profit-bar hidden'; if(wrap) wrap.classList.remove('loss'); return; }
            const diff=sale-buy, p=((diff/buy)*100).toFixed(0);
            if(!bar) return;
            if(diff<0){ bar.className='pm-profit-bar loss'; txt.innerHTML=`<i class="bi bi-exclamation-triangle-fill me-1"></i>زەرەر: ${fmt(Math.abs(diff))}`; pct.textContent=`${Math.abs(p)}%`; if(wrap) wrap.classList.add('loss'); }
            else { bar.className=diff===0?'pm-profit-bar zero':'pm-profit-bar gain'; txt.innerHTML=diff===0?'سەربەسەر':`<i class="bi bi-arrow-up-circle-fill me-1"></i>قازانج: ${fmt(diff)}`; pct.textContent=`${Math.abs(p)}%`; if(wrap) wrap.classList.remove('loss'); }
        }

        async function saveNewProduct() {
            const name=$('newProdName').value.trim();
            if(!name){ $('newProdMsg').innerHTML='<span style="color:var(--danger);">ناوی کاڵا پێویستە</span>'; return; }
            $('newProdMsg').innerHTML='<span style="color:var(--info);">پاشەکەوتکردن...</span>';
            const fd=new FormData();
            fd.append('NewProductName',name); fd.append('NewProductBarcode',$('newProdBarcode').value.trim());
            fd.append('NewProductSalePrice',parseFloat($('newProdSalePrice').value)||0);
            fd.append('NewProductWholesalePrice',parseFloat($('newProdWholesalePrice')?.value)||0);
            fd.append('NewProductBuyPrice',parseFloat($('newProdBuyPrice').value)||0);
            fd.append('NewProductCarton',parseInt($('newProdCarton')?.value)||1);
            fd.append('NewProductDozen',parseInt($('newProdDozen')?.value)||1);
            fd.append('NewProductBundle',parseInt($('newProdBundle')?.value)||1);
            fd.append('__RequestVerificationToken',document.querySelector('input[name="__RequestVerificationToken"]').value);
            try {
                const r=await fetch('?handler=AddNewProduct',{method:'POST',body:fd}), d=await r.json();
                if(d.success){
                    const buy=parseFloat($('newProdBuyPrice').value)||0, sale=parseFloat($('newProdSalePrice').value)||0, qty=parseInt($('newProdQty').value)||1;
                    const cr=parseInt($('newProdCarton')?.value)||1, dz=parseInt($('newProdDozen')?.value)||1, bn=parseInt($('newProdBundle')?.value)||1;
                    PD[d.productId]={name,sale,stock:0,carton:cr,dozen:dz,bundle:bn};
                    items.push({productId:d.productId,name,price:buy,qty,unit:1,carton:cr,dozen:dz,bundle:bn,stock:0,sale});
                    
                    const opt=new Option(name+' (ستۆک: 0)',d.productId);
                    opt.dataset.name=name; opt.dataset.stock='0'; opt.dataset.sale=sale; opt.dataset.carton=cr; opt.dataset.dozen=dz; opt.dataset.bundle=bn;
                    $('productSelect').appendChild(opt);
                    allProductOptions.push(opt); // زیادکرا بۆ فلتەرەکە

                    renderItems(); closeNewProductModal();
                    showMsg('<i class="bi bi-check-circle-fill"></i> '+name+' تۆمارکرا و زیادکرا','ok');
                    ['newProdName','newProdBarcode','newProdSalePrice','newProdBuyPrice','newProdWholesalePrice'].forEach(function(id){ var el=$(id); if(el) el.value=''; });
                    if($('newProdCarton')) $('newProdCarton').value='1';
                    if($('newProdDozen')) $('newProdDozen').value='1';
                    if($('newProdBundle')) $('newProdBundle').value='1';
                    $('newProdQty').value='1'; $('newProdMsg').innerHTML='';
                    if($('newProfitBar')) $('newProfitBar').className='pm-profit-bar hidden';
                } else $('newProdMsg').innerHTML='<span style="color:var(--danger);">'+(d.message||'هەڵە')+'</span>';
            } catch(e){ $('newProdMsg').innerHTML='<span style="color:var(--danger);">هەڵەی پەیوەندی</span>'; }
        }

        // قاسە
        var _cashBalance = 0;
        async function loadCashBalance() {
            try { var r = await fetch('/CashRegister?handler=Stats'); var d = await r.json(); if (d.success) { _cashBalance = d.current; updateCashDisplay(); } } catch(e){}
        }
        function updateCashDisplay() {
            var el = $('cashBalDisplay');
            if (el) { el.textContent = '(' + new Intl.NumberFormat('en').format(_cashBalance) + ')'; el.style.display = ''; el.style.color = _cashBalance > 0 ? 'var(--success)' : 'var(--danger)'; }
        }
        function toggleCashPay() { var cb = $('cashPayCheck'); if (cb) { cb.checked = !cb.checked; updateCashDisplay(); } }
        document.getElementById('purchaseModal')?.addEventListener('show.bs.modal', function(){ loadCashBalance(); });

        async function savePurchase() {
            if(!items.length){ showMsg('<i class="bi bi-x-circle-fill"></i> تکایە کاڵا زیاد بکە','err'); return; }
            if(items.some(i=>!i.price||i.price<=0)){ showMsg('<i class="bi bi-x-circle-fill"></i> پێویستە نرخی هەموو کاڵاکان بنووسرێت','err'); return; }
            var payFromCash = $('cashPayCheck')?.checked || false;
            if (payFromCash) {
                var totalCost = items.reduce(function(s,i){ return s + (i.price * i.qty); }, 0);
                if (totalCost > _cashBalance) { showMsg('<i class="bi bi-x-circle-fill"></i> باڵانسی قاسە بەسی نییە!','err'); return; }
            }
            const editId=$('editPurchaseId').value;
            const toSend=items.map(i=>({ProductId:i.productId,Quantity:i.qty*i.unit,UnitPrice:i.unit>1?i.price/i.unit:i.price}));
            const fd=new FormData();
            fd.append('ItemsJson',JSON.stringify(toSend));
            fd.append('NewPurchase.PurchaseDate',$('purchaseDate').value);
            fd.append('NewPurchaseSupplierId', $('supplierSelect')?.value || '1');
            fd.append('EditPurchaseId',editId);
            fd.append('PayFromCash', payFromCash ? 'true' : 'false');
            fd.append('__RequestVerificationToken',document.querySelector('input[name="__RequestVerificationToken"]').value);
            try {
                const h=editId&&editId!=='0'?'EditPurchase':'AddPurchase';
                const r=await fetch('?handler='+h,{method:'POST',body:fd}), d=await r.json();
                if(d.success) location.reload(); else showMsg('<i class="bi bi-x-circle-fill"></i> '+(d.message||'هەڵە'),'err');
            } catch(e){ showMsg('<i class="bi bi-x-circle-fill"></i> هەڵە','err'); }
        }

        function resetPurchaseModal() {
            $('editPurchaseId').value='0';
            $('purchaseModalTitle').textContent='تۆمارکردنی پسوڵەی کڕین';
            const hdr=$('purchaseModalHeader');
            if(hdr){ hdr.style.background=''; hdr.style.borderBottomColor=''; }
            const _now=new Date(), _pad=n=>String(n).padStart(2,'0');
            const _dateStr=`${_now.getFullYear()}-${_pad(_now.getMonth()+1)}-${_pad(_now.getDate())}`;
            const _timeStr=`${_pad(_now.getHours())}:${_pad(_now.getMinutes())}`;
            if($('purchaseDateOnly')){ $('purchaseDateOnly').value=_dateStr; $('purchaseDateOnly').max=_dateStr; $('purchaseDateOnly').readOnly=false; $('purchaseDateOnly').style.background=''; $('purchaseDateOnly').style.color=''; }
            if($('purchaseTime')){ $('purchaseTime').value=_timeStr; $('purchaseTime').max=_timeStr; $('purchaseTime').readOnly=false; $('purchaseTime').style.background=''; $('purchaseTime').style.color=''; }
            syncPurchaseDateTime();
            if($('supplierSelect')) $('supplierSelect').value='1';
            items=[]; renderItems(); const m=$('searchMessage'); if(m) m.innerHTML='';
            clearProductForm(); $('productSelect').value=''; $('priceInfoRow').style.display='none';
            
            // خاڵیکردنەوەی ئینپوتی گەڕانەکە و گەڕاندنەوەی لیستی کاڵاکان بۆ دۆخی ئاسایی
            if($('localSearchInput')) {
                $('localSearchInput').value = '';
                filterLocalProducts();
            }
        }
        $('purchaseModal')?.addEventListener('shown.bs.modal',()=>$('barcodeInput')?.focus());
        $('purchaseModal')?.addEventListener('hidden.bs.modal',resetPurchaseModal);

        // دوو جار کلیک
        function bindDblClick() {
            document.querySelectorAll('#purchaseTbody tr[data-id]').forEach(function(row) {
                if (row._dbl) row.removeEventListener('dblclick', row._dbl);
                row._dbl = async function(e) {
                    if (e.target.closest('.delete-btn,.edit-btn')) return;
                    var id = this.dataset.id; if (!id) return;
                    try { var r = await fetch('?handler=GetPurchase&id=' + id); var d = await r.json(); if (d.success) showViewModal(d); } catch(ex) { console.error(ex); }
                };
                row.addEventListener('dblclick', row._dbl);
            });
        }

        function showViewModal(d) {
            var old = document.getElementById('dynViewModal'); if (old) old.remove();
            var totalCost = 0, totalQty = 0, rowsHtml = '', idx = 1;
            (d.items || []).forEach(function(it) {
                var sub = it.quantity * it.unitPrice; totalCost += sub; totalQty += it.quantity;
                rowsHtml += '<tr style="border-bottom:1px solid var(--border-subtle);">' +
                    '<td style="padding:8px 10px;font-size:11px;color:var(--text-dim);font-weight:600;width:30px;">' + idx + '</td>' +
                    '<td style="padding:8px 10px;"><div style="font-size:13px;font-weight:600;color:var(--text-primary);">' + (it.name||'—') + '</div></td>' +
                    '<td style="padding:8px 10px;text-align:center;font-size:13px;font-weight:700;color:var(--text-primary);">' + it.quantity + '</td>' +
                    '<td style="padding:8px 10px;font-size:12px;color:var(--text-secondary);font-weight:500;">' + fmt(it.unitPrice) + '</td>' +
                    '<td style="padding:8px 10px;font-size:13px;font-weight:700;color:var(--text-primary);">' + fmt(sub) + '</td></tr>';
                idx++;
            });
            var itemCount = (d.items || []).length;
            var date = (d.purchaseDate || '').split('T');
            var dateStr = (date[0]||'').replace(/-/g, '/');
            var timeStr = (date[1]||'').substring(0,5);
            var supplierHtml = '';
            if (d.supplierId && d.supplierId !== 1) {
                supplierHtml = '<div style="text-align:center;"><div style="font-size:11px;color:var(--text-dim);font-weight:600;margin-bottom:2px;">دابینکەر</div>' +
                    '<div style="font-size:13px;font-weight:700;color:var(--info);display:flex;align-items:center;gap:4px;"><i class="bi bi-building"></i>' + (d.supplierName||'') + '</div></div>';
            }

            var html = '<div class="modal fade pu-modal" id="dynViewModal" tabindex="-1">' +
                '<div class="modal-dialog modal-dialog-centered" style="max-width:580px;">' +
                '<div class="modal-content">' +
                '<div style="padding:18px 24px 14px;border-bottom:1px solid var(--border-subtle);">' +
                '<div style="display:flex;justify-content:space-between;align-items:flex-start;">' +
                '<div><div style="font-size:18px;font-weight:800;color:var(--text-primary);">فرۆشگای MyStore</div>' +
                '<div style="font-size:12px;color:var(--text-muted);margin-top:2px;">پسوڵەی کڕینی مەواد</div></div>' +
                '<div style="text-align:left;"><div style="font-size:11px;color:var(--text-dim);font-weight:600;">ژمارەی پسوڵە</div>' +
                '<div style="font-size:20px;font-weight:800;color:var(--text-primary);line-height:1.1;">#' + d.purchaseId + '</div></div></div>' +
                '<div style="border-top:1px dashed var(--border-card);margin:14px 0 12px;"></div>' +
                '<div style="display:flex;justify-content:space-between;align-items:flex-start;">' +
                '<div><div style="font-size:11px;color:var(--text-dim);font-weight:600;margin-bottom:2px;">بەروار و کات</div>' +
                '<div style="font-size:13px;font-weight:700;">' + dateStr + '</div>' +
                '<div style="font-size:12px;color:var(--text-muted);">' + timeStr + '</div></div>' +
                supplierHtml +
                '<div style="text-align:center;"><div style="font-size:11px;color:var(--text-dim);font-weight:600;margin-bottom:2px;">کۆی دانە</div>' +
                '<div style="font-size:13px;font-weight:700;">' + totalQty + ' دانە</div>' +
                '<div style="font-size:12px;color:var(--text-muted);">(' + itemCount + ' جۆر)</div></div>' +
                '<div style="text-align:left;"><div style="font-size:11px;color:var(--text-dim);font-weight:600;margin-bottom:2px;">کۆی تێچوو</div>' +
                '<div style="font-size:13px;font-weight:700;color:var(--success);">' + fmt(totalCost) + '</div>' +
                '<div style="font-size:12px;color:var(--text-dim);">دینار</div></div></div></div>' +
                '<div style="max-height:300px;overflow-y:auto;">' +
                '<table style="width:100%;border-collapse:collapse;">' +
                '<thead><tr style="border-bottom:1px solid var(--border-subtle);">' +
                '<th style="padding:8px 10px;font-size:11px;color:var(--text-muted);font-weight:700;background:var(--pu-thead);">#</th>' +
                '<th style="padding:8px 10px;font-size:11px;color:var(--text-muted);font-weight:700;background:var(--pu-thead);">ناوی کاڵا</th>' +
                '<th style="padding:8px 10px;font-size:11px;color:var(--text-muted);font-weight:700;text-align:center;background:var(--pu-thead);">بڕ</th>' +
                '<th style="padding:8px 10px;font-size:11px;color:var(--text-muted);font-weight:700;text-align:left;background:var(--pu-thead);">نرخی دانە</th>' +
                '<th style="padding:8px 10px;font-size:11px;color:var(--text-muted);font-weight:700;text-align:left;background:var(--pu-thead);">کۆی تێچوو</th>' +
                '</tr></thead><tbody>' + rowsHtml + '</tbody></table></div>' +
                '<div style="border-top:2px solid var(--text-primary);padding:14px 24px;display:flex;justify-content:space-between;align-items:center;">' +
                '<span style="font-size:15px;font-weight:700;">کۆی گشتی پسوڵە</span>' +
                '<span style="font-size:18px;font-weight:800;">' + fmt(totalCost) + ' <span style="font-size:11px;font-weight:400;color:var(--text-muted);">دینار</span></span></div>' +
                '<div class="pm-footer" style="padding:10px 24px;"><div style="font-size:11px;color:var(--text-dim);font-style:italic;">سیستەمی MyStore</div>' +
                '<div style="display:flex;gap:8px;">' +
                '<button type="button" onclick="window.print()" class="pm-btn-cancel" style="height:30px;padding:0 12px;font-size:12px;"><i class="bi bi-printer me-1"></i> چاپکردن</button>' +
                '<button type="button" data-bs-dismiss="modal" class="pm-btn-cancel" style="height:30px;padding:0 12px;font-size:12px;">داخستن</button>' +
                '</div></div></div></div></div>';

            document.body.insertAdjacentHTML('beforeend', html);
            var modal = new bootstrap.Modal(document.getElementById('dynViewModal'));
            modal.show();
            document.getElementById('dynViewModal').addEventListener('hidden.bs.modal', function() { this.remove(); });
        }
        bindDblClick();

        function bindEditBtns() {
            document.querySelectorAll('.edit-btn').forEach(btn=>{
                if (btn._bound) return; btn._bound = true;
                btn.addEventListener('click', async function(){
                    const id=this.dataset.id, r=await fetch('?handler=GetPurchase&id='+id), d=await r.json();
                    if(d.success){
                        $('editPurchaseId').value=id;
                        $('purchaseModalTitle').textContent='دەستکاری پسوڵە #'+id;
                        const hdr=$('purchaseModalHeader');
                        if(hdr){ hdr.style.background='linear-gradient(135deg,rgba(252,211,77,.1),rgba(217,119,6,.08))'; hdr.style.borderBottomColor='rgba(252,211,77,.2)'; }
                        const _ep=d.purchaseDate||'';
                        const _ed=_ep.split('T')[0]||'', _et=_ep.split('T')[1]||'';
                        if($('purchaseDateOnly')){ $('purchaseDateOnly').value=_ed; $('purchaseDateOnly').readOnly=true; $('purchaseDateOnly').style.background='var(--accent-bg)'; $('purchaseDateOnly').style.color='var(--accent-text)'; }
                        if($('purchaseTime')){ $('purchaseTime').value=_et.substring(0,5); $('purchaseTime').readOnly=true; $('purchaseTime').style.background='var(--accent-bg)'; $('purchaseTime').style.color='var(--accent-text)'; }
                        $('purchaseDate').value=_ep;
                        if($('supplierSelect')) $('supplierSelect').value = d.supplierId || '1';
                        items=d.items.map(it=>{ const pd=PD[it.productId]||{};
                            return {productId:it.productId,name:it.name,price:it.unitPrice,qty:it.quantity,unit:1,
                                carton:it.qtyPerCarton||1,dozen:it.qtyPerDozen||1,bundle:it.qtyPerBundle||1,stock:it.currentStock||0,sale:pd.sale||0};
                        });
                        renderItems(); new bootstrap.Modal($('purchaseModal')).show();
                    }
                });
            });
        }

        function bindDeleteBtns() {
            document.querySelectorAll('.delete-btn').forEach(btn=>{
                if (btn._bound) return; btn._bound = true;
                btn.addEventListener('click',function(){
                    $('deleteId').value=this.dataset.id;
                    $('deleteInvoiceId').textContent='#'+this.dataset.id;
                    $('deleteInvoiceDate').textContent=this.dataset.date;
                    $('deleteInvoiceCount').textContent=this.dataset.count;
                    $('deleteInvoiceTotal').textContent=parseInt(this.dataset.total).toLocaleString();
                    new bootstrap.Modal($('deleteModal')).show();
                });
            });
        }
        bindEditBtns(); bindDeleteBtns();

        async function confirmDelete(){
            const fd=new FormData();
            fd.append('DeletePurchaseId',$('deleteId').value);
            fd.append('__RequestVerificationToken',document.querySelector('input[name="__RequestVerificationToken"]').value);
            const r=await fetch('?handler=DeletePurchase',{method:'POST',body:fd}), d=await r.json();
            if(d.success) location.reload(); else alert(d.message);
        }

        // Fullscreen
        function toggleFullscreen(){
            const card=$('mainCard'), icon=$('expandIcon');
            if (!document.fullscreenElement && !document.webkitFullscreenElement) {
                if (card.requestFullscreen) card.requestFullscreen();
                else if (card.webkitRequestFullscreen) card.webkitRequestFullscreen();
            } else {
                if (document.exitFullscreen) document.exitFullscreen();
                else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
            }
        }
        document.addEventListener('fullscreenchange', updateFsIcon);
        document.addEventListener('webkitfullscreenchange', updateFsIcon);
        function updateFsIcon() {
            const card=$('mainCard'), icon=$('expandIcon');
            if (document.fullscreenElement || document.webkitFullscreenElement) {
                card.classList.add('is-fullscreen'); icon.className = 'bi bi-fullscreen-exit';
            } else {
                card.classList.remove('is-fullscreen'); icon.className = 'bi bi-arrows-fullscreen';
            }
        }

        // Filter + Pagination
        var _purWrapper = $('content-purchase');
        function buildFilterUrl(page) {
            var params = new URLSearchParams();
            var rng = $('fDateRange')?.value || 'Today';
            if (rng) params.set('FilterDateRange', rng);
            if (rng === 'Custom') {
                var s = $('fStartDate')?.value, e = $('fEndDate')?.value;
                if (s) params.set('StartDate', s); if (e) params.set('EndDate', e);
            }
            if (page && page > 1) params.set('CurrentPage', page);
            var q = params.toString();
            return window.location.pathname + (q ? '?' + q : '');
        }

        function updateStats(stats) {
            if (!stats) return;
            var el1 = $('statInvoices'), el2 = $('statPurchases'), el3 = $('statProducts');
            if (el1) el1.textContent = stats.invoices;
            if (el2) el2.textContent = Number(stats.purchases).toLocaleString('en-US', {maximumFractionDigits:0});
            if (el3) el3.textContent = stats.products;
        }

        async function purFetch(url) {
            var sp = $('filterSpinner'), rc = $('filterResultCount');
            if (sp) sp.style.display = 'inline'; if (rc) rc.style.display = 'none';
            try {
                var html = await (await fetch(url)).text();
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var fresh = doc.getElementById('content-purchase');
                if (fresh && _purWrapper) { _purWrapper.innerHTML = fresh.innerHTML; bindDblClick(); bindEditBtns(); bindDeleteBtns(); }
                var scriptEl = doc.querySelector('#content-purchase script');
                if (scriptEl) { try { eval(scriptEl.textContent); } catch(ex) {} }
                if (typeof _pgData !== 'undefined') renderPagination(_pgData);
                if (typeof _statsData !== 'undefined') updateStats(_statsData);
                if (rc && typeof _pgData !== 'undefined') { rc.textContent = _pgData.filtered + ' پسوڵە'; rc.style.display = ''; }
                window.history.pushState(null, '', url);
            } catch(e) { console.error('purFetch:', e); }
            finally { if (sp) sp.style.display = 'none'; }
        }

        function renderPagination(pg) {
            var btns = $('pgBtns'), info = $('pgInfo');
            if (!btns || !pg || pg.total <= 1) { if (btns) btns.innerHTML = ''; return; }
            var cur = pg.current, tot = pg.total;
            if (info) info.innerHTML = '<strong>' + (((cur-1)*pg.pageSize)+1) + '–' + Math.min(cur*pg.pageSize, pg.filtered) + '</strong> لە <strong>' + pg.filtered + '</strong> پسوڵە';
            var nums = [];
            if (tot <= 7) { for (var i=1;i<=tot;i++) nums.push(i); }
            else if (cur <= 4) nums = [1,2,3,4,5,null,tot];
            else if (cur >= tot-3) { nums=[1,null]; for(var i=tot-4;i<=tot;i++) nums.push(i); }
            else nums = [1,null,cur-1,cur,cur+1,null,tot];
            var h = '';
            h += cur>1 ? '<button class="pg-btn" onclick="goToPage('+(cur-1)+')"><i class="bi bi-chevron-right"></i></button>' : '<button class="pg-btn" disabled><i class="bi bi-chevron-right"></i></button>';
            for (var i=0;i<nums.length;i++) {
                if (nums[i]===null) h += '<span class="pg-dots">…</span>';
                else h += '<button class="pg-btn'+(nums[i]===cur?' active':'')+'" onclick="goToPage('+nums[i]+')">'+nums[i]+'</button>';
            }
            h += cur<tot ? '<button class="pg-btn" onclick="goToPage('+(cur+1)+')"><i class="bi bi-chevron-left"></i></button>' : '<button class="pg-btn" disabled><i class="bi bi-chevron-left"></i></button>';
            btns.innerHTML = h;
        }
        function goToPage(p) { if(p) purFetch(buildFilterUrl(p)); }

        $('fDateRange')?.addEventListener('change', function() {
            var rng = this.value;
            var box = $('fCustomDates');
            if (box) box.style.display = (rng === 'Custom') ? 'flex' : 'none';
            if (rng !== 'Custom') purFetch(buildFilterUrl(1));
        });
        $('fStartDate')?.addEventListener('change', function() { purFetch(buildFilterUrl(1)); });
        $('fEndDate')?.addEventListener('change', function() { purFetch(buildFilterUrl(1)); });

        // دوگمەکانی بەرواری پێشکەشکراو
        document.querySelectorAll('#dateRangeBtns button').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('#dateRangeBtns button').forEach(function(b) { b.classList.remove('active'); });
                this.classList.add('active');
                var val = this.dataset.val;
                var sel = $('fDateRange');
                if (sel) sel.value = val;
                var box = $('fCustomDates');
                if (box) box.style.display = (val === 'Custom') ? 'flex' : 'none';
                if (val !== 'Custom') purFetch(buildFilterUrl(1));
            });
        });

        function recalcVisibleStats() {
            var rows = document.querySelectorAll('#purchaseTbody tr');
            var count = 0, total = 0;
            rows.forEach(function(r) {
                if (r.style.display !== 'none') {
                    count++;
                    var costCell = r.querySelector('td:nth-child(8)');
                    if (costCell) { var val = parseInt((costCell.textContent || '0').replace(/,/g, '')) || 0; total += val; }
                }
            });
            var el1 = $('statInvoices'), el2 = $('statPurchases');
            if (el1) el1.textContent = count;
            if (el2) el2.textContent = Number(total).toLocaleString('en-US', {maximumFractionDigits:0});
            var rc = $('filterResultCount'); if (rc) rc.textContent = count + ' پسوڵە';
        }

        var _fT = null;
        $('fInvoice')?.addEventListener('input', function() {
            clearTimeout(_fT);
            var inv = this.value.trim().toLowerCase();
            _fT = setTimeout(function() {
                document.querySelectorAll('#purchaseTbody tr').forEach(function(r) {
                    r.style.display = (!inv || (r.dataset.invoice||'').includes(inv)) ? '' : 'none';
                });
                recalcVisibleStats();
            }, 300);
        });

        window.addEventListener('popstate', function() { purFetch(window.location.href); });
        if (typeof _pgData !== 'undefined') renderPagination(_pgData);
        if (typeof _statsData !== 'undefined') updateStats(_statsData);
    </script>
}