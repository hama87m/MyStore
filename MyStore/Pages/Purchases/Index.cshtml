@page
@model MyStore.Pages.Purchases.IndexModel
@{
    ViewData["Title"] = "کڕینەکان";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* ══ هێنانی فۆنتەکە ══ */
    @@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap');

    /* ══ سڕینەوەی پادینگە باوەکان بۆ ڕێکبوونی لەگەڵ لایئەوتە نوێیەکە ══ */
    main, .container, .container-fluid, .p-3, .p-4, .pb-3, .content-wrapper, .body-content {
        padding: 0 !important;
    }

    footer {
        display: none !important;
    }

    /* ══ گۆڕاوەکان کە لە لایئەوتەوە کۆنتڕۆڵ دەکرێن ══ */
    :root {
        --pu-page: #0b1120;
        --pu-card: rgba(15,23,42,.7);
        --pu-stat: rgba(15,23,42,.6);
        --pu-thead: rgba(15,23,42,.5);
        --pu-hover: rgba(99,102,241,.04);
        --pu-input: rgba(30,41,59,.8);
        --border-card: rgba(148,163,184,.08);
        --border-subtle: rgba(148,163,184,.06);
        --border-focus: rgba(129,140,248,.5);
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --text-dim: #475569;
        --accent: #818cf8;
        --accent-text: #a5b4fc;
        --accent-bg: rgba(99,102,241,.12);
        --accent-border: rgba(99,102,241,.2);
        --success: #6ee7b7;
        --success-bg: rgba(52,211,153,.1);
        --danger: #fda4af;
        --danger-bg: rgba(251,113,133,.1);
        --warning: #fcd34d;
        --warning-bg: rgba(252,211,77,.1);
        --info: #93c5fd;
        --info-bg: rgba(59,130,246,.1);
        --cyan: #67e8f9;
        --cyan-bg: rgba(6,182,212,.1);
        --gradient-top: linear-gradient(135deg, rgba(30,27,75,.4), rgba(49,46,129,.3), rgba(30,27,75,.2));
        --shadow-sm: none;
    }

    /* ══ گۆڕاوەکان — ڕووناک ══ */
    [data-theme="light"] {
        --pu-page: #eef1f6;
        --pu-card: #ffffff;
        --pu-stat: #ffffff;
        --pu-thead: #f8f9fb;
        --pu-hover: rgba(99,102,241,.03);
        --pu-input: #ffffff;
        --border-card: #dde0e7;
        --border-subtle: #eaecf0;
        --border-focus: rgba(99,102,241,.45);
        --text-primary: #111827;
        --text-secondary: #374151;
        --text-muted: #4b5563;
        --text-dim: #6b7280;
        --accent: #6366f1;
        --accent-text: #4338ca;
        --accent-bg: rgba(99,102,241,.06);
        --accent-border: rgba(99,102,241,.12);
        --success: #047857;
        --success-bg: rgba(4,120,87,.08);
        --danger: #be123c;
        --danger-bg: rgba(190,18,60,.06);
        --warning: #b45309;
        --warning-bg: rgba(217,119,6,.08);
        --info: #2563eb;
        --info-bg: rgba(59,130,246,.08);
        --cyan: #0891b2;
        --cyan-bg: rgba(6,182,212,.08);
        --gradient-top: linear-gradient(135deg, rgba(238,242,255,.95), rgba(224,231,255,.7), rgba(238,242,255,.5));
        --shadow-sm: 0 1px 3px rgba(0,0,0,.06);
    }

    /* ══ ڕێکخستنی بنەڕەتی ══ */
    .pu-page {
        direction: rtl;
        font-family: 'IBM Plex Sans Arabic', sans-serif;
        background: var(--pu-page);
        color: var(--text-primary);
        min-height: 100vh;
        position: relative;
        transition: background .35s, color .35s;
    }

        .pu-page::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 260px; /* وەک فرۆشتنەکان 260px */
            background: var(--gradient-top);
            pointer-events: none;
            transition: background .35s;
        }

    .pu-in {
        position: relative;
        z-index: 1;
        padding: 20px 24px; /* وەک فرۆشتنەکان */
        display: flex;
        flex-direction: column;
        gap: 12px; /* وەک فرۆشتنەکان */
        height: 100vh;
    }

    /* ══ هێدەر ══ */
    .pu-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px; /* وەک فرۆشتنەکان */
        flex-shrink: 0;
    }

        .pu-top h1 {
            font-size: 18px; /* وەک فرۆشتنەکان 18px */
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 2px;
            transition: color .35s;
        }

        .pu-top p {
            font-size: 11px;
            color: var(--text-muted);
            margin: 0;
            transition: color .35s;
        }

    .pu-top-ico {
        width: 32px; /* وەک فرۆشتنەکان 32px */
        height: 32px;
        border-radius: 50%; /* وەک فرۆشتنەکان 50% */
        background: linear-gradient(135deg, #6366f1, #818cf8);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #fff;
        font-size: 14px;
    }

    /* ══ دوگمەی نوێ ══ */
    .btn-act-main {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 30px;
        padding: 0 20px;
        border-radius: 8px;
        border: none;
        color: #ffffff !important;
        font-size: 12px;
        font-weight: 400;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
        overflow: hidden;
        font-family: inherit;
    }

        .btn-act-main i {
            font-size: 15px;
        }

        /* ئێفێکتی تێپەڕبوونی ڕووناکی (Shine) */
        .btn-act-main::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
            transform: skewX(-20deg);
            transition: left 0.5s ease;
        }

        .btn-act-main:hover {
            transform: translateY(-2px);
        }

            .btn-act-main:hover::after {
                left: 150%;
            }

    /* ڕەنگی مۆری درەوشاوە بۆ دووگمەی سەرەکی */
    .btn-act-primary {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

        .btn-act-primary:hover {
            box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
        }


    /* ══ ٣ کارتی ئامار ══ */
    .pu-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        flex-shrink: 0;
    }

    .pu-st {
        background: var(--pu-stat);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        padding: 14px 16px;
        transition: all .35s;
        box-shadow: var(--shadow-sm);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .pu-st:hover {
            border-color: rgba(99,102,241,.3);
            transform: translateY(-1px);
        }

    .pu-st-lbl {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 400;
        margin-bottom: 6px;
    }

    .pu-st-val {
        font-size: 22px;
        font-weight: 600;
        line-height: 1;
        transition: color .35s;
    }

    .pu-st-sub {
        font-size: 11px;
        color: var(--text-dim);
        margin-top: 4px;
    }

    .pu-st-ico {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .c-indigo {
        color: var(--accent-text);
    }

    .bg-indigo {
        background: var(--accent-bg);
        color: var(--accent);
    }

    .c-cyan {
        color: var(--cyan);
    }

    .bg-cyan {
        background: var(--cyan-bg);
        color: var(--cyan);
    }

    .c-info {
        color: var(--info);
    }

    .bg-info-c {
        background: var(--info-bg);
        color: var(--info);
    }

    .c-emerald {
        color: var(--success);
    }

    .bg-emerald {
        background: var(--success-bg);
        color: var(--success);
    }

    .c-rose {
        color: var(--danger);
    }

    .bg-rose {
        background: var(--danger-bg);
        color: var(--danger);
    }

    .c-amber {
        color: var(--warning);
    }

    .bg-amber {
        background: var(--warning-bg);
        color: var(--warning);
    }

    /* ══ کارتی سەرەکی (خشتە) ══ */
    .pu-card {
        background: var(--pu-card);
        border: 1px solid var(--border-card);
        border-radius: 12px; /* وەک فرۆشتنەکان 12px */
        overflow: hidden;
        transition: all .35s;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }

    /* ══ گرووپی دوگمەی بەرواری پێشکەشکراو ══ */
    .rc-btn-group {
        display: inline-flex;
        background: var(--pu-input);
        border: 1px solid var(--border-card);
        border-radius: 8px;
        padding: 3px;
        gap: 2px;
    }

        .rc-btn-group button {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            padding: 4px 12px;
            font-size: 11px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
        }

            .rc-btn-group button:hover {
                color: var(--text-primary);
            }

            .rc-btn-group button.active {
                background: linear-gradient(135deg, var(--accent), #4f46e5);
                color: #fff;
                box-shadow: 0 2px 6px rgba(99, 102, 241, 0.3);
            }

    /* ══ تولبار ══ */
    .pu-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 14px; /* وەک فرۆشتنەکان */
        border-bottom: 1px solid var(--border-subtle);
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    /* ══ ئینپوت ══ */
    .pu-inp {
        height: 28px; /* وەک فرۆشتنەکان */
        padding: 0 10px; /* وەک فرۆشتنەکان */
        background: var(--pu-input);
        border: 1px solid var(--border-card);
        border-radius: 6px; /* وەک فرۆشتنەکان 6px */
        color: var(--text-primary);
        font-size: 11px; /* وەک فرۆشتنەکان */
        font-family: inherit;
        outline: none;
        transition: all .25s;
    }

        .pu-inp option {
            background-color: var(--pu-card);
            color: var(--text-primary);
        }

        .pu-inp:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px var(--accent-bg); /* وەک فرۆشتنەکان 3px */
        }

        .pu-inp::placeholder {
            color: var(--text-dim);
            opacity: 0.7;
        }

        .pu-inp::-webkit-calendar-picker-indicator {
            cursor: pointer;
            opacity: 0.6;
            filter: invert(var(--icon-invert, 0));
            padding: 0;
            margin-right: 4px;
        }

    [data-theme="light"] .pu-inp::-webkit-calendar-picker-indicator {
        --icon-invert: 0;
    }

    :root .pu-inp::-webkit-calendar-picker-indicator {
        --icon-invert: 1;
    }

    /* ══ دوگمەکان ══ */
    .pu-btn {
        height: 28px; /* وەک فرۆشتنەکان */
        padding: 0 12px; /* وەک فرۆشتنەکان */
        border-radius: 6px; /* وەک فرۆشتنەکان */
        font-size: 11px; /* وەک فرۆشتنەکان */
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        transition: all .2s;
        border: none;
        text-decoration: none;
    }

    .pu-btn-ghost {
        background: var(--pu-input);
        color: var(--text-secondary);
        border: 1px solid var(--border-card);
    }

        .pu-btn-ghost:hover {
            background: var(--pu-hover);
            color: var(--text-primary);
        }

    /* ══ خشتە ══ */
    .pu-tbl-scroll {
        flex: 1;
        overflow-y: auto;
        overflow-x: auto;
        min-height: 0;
    }

        .pu-tbl-scroll::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .pu-tbl-scroll::-webkit-scrollbar-track {
            background: var(--pu-card);
        }

        .pu-tbl-scroll::-webkit-scrollbar-thumb {
            background: var(--text-muted);
            border-radius: 6px;
        }

            .pu-tbl-scroll::-webkit-scrollbar-thumb:hover {
                background: var(--text-secondary);
            }

    /* ══ سکڕۆڵی گشتی هاوشێوەی دەفتەری قەرزەکان ══ */
    ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    ::-webkit-scrollbar-track {
        background: var(--pu-card);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--text-muted);
        border-radius: 6px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--text-secondary);
        }

    * {
        scrollbar-width: thin;
        scrollbar-color: var(--text-muted) var(--pu-card);
    }

    .pu-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .pu-tbl th {
            padding: 8px 12px; /* وەک فرۆشتنەکان */
            text-align: right;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            background: var(--pu-thead);
            border-bottom: 1px solid var(--border-subtle);
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 5;
            transition: all .35s;
        }

        .pu-tbl td {
            padding: 6px 12px; /* وەک فرۆشتنەکان */
            font-size: 12px;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-subtle);
            vertical-align: middle;
            transition: all .35s;
            white-space: nowrap;
        }

        .pu-tbl tr {
            transition: background .15s;
        }

            .pu-tbl tr:hover {
                background: var(--pu-hover);
            }

            .pu-tbl tr:last-child td {
                border-bottom: none;
            }

    /* ══ badge ══ */
    .pu-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px; /* وەک فرۆشتنەکان */
        border-radius: 5px; /* وەک فرۆشتنەکان */
        font-size: 12px; /* وەک فرۆشتنەکان */
        font-weight: 600;
        white-space: nowrap;
    }

        .pu-badge.product {
            background: var(--success-bg);
            color: var(--success);
            border: 1px solid rgba(52,211,153,.15);
        }

        .pu-badge.more {
            background: var(--warning-bg);
            color: var(--warning);
            border: 1px solid rgba(252,211,77,.15);
        }

        .pu-badge.supplier {
            background: var(--info-bg);
            color: var(--info);
            border: 1px solid rgba(59,130,246,.15);
        }

    /* ══ دوگمەکانی کردار ══ */
    .act-btn {
        width: 28px; /* وەک فرۆشتنەکان */
        height: 28px; /* وەک فرۆشتنەکان */
        border-radius: 6px; /* وەک فرۆشتنەکان */
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all .2s;
        cursor: pointer;
        font-size: 13px; /* وەک فرۆشتنەکان */
    }

        .act-btn.edit {
            color: var(--warning);
            background: var(--warning-bg);
            border-color: rgba(252,211,77,.2);
        }

            .act-btn.edit:hover {
                background: var(--warning);
                color: #fff;
            }

        .act-btn.delete {
            color: var(--danger);
            background: var(--danger-bg);
            border-color: rgba(251,113,133,.2);
        }

            .act-btn.delete:hover {
                background: var(--danger);
                color: #fff;
            }

    /* ══ Pagination ══ */
    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px; /* وەک فرۆشتنەکان */
        background: var(--pu-card);
        border-top: 1px solid var(--border-subtle);
        gap: 10px; /* وەک فرۆشتنەکان */
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    .pg-info {
        font-size: 12px; /* وەک فرۆشتنەکان */
        color: var(--text-dim);
    }

        .pg-info strong {
            color: var(--text-primary);
            font-weight: 700;
        }

    .pg-controls {
        display: flex;
        gap: 4px;
    }

    .pg-btn {
        height: 28px; /* وەک فرۆشتنەکان */
        min-width: 28px; /* وەک فرۆشتنەکان */
        padding: 0 10px; /* وەک فرۆشتنەکان */
        border-radius: 6px; /* وەک فرۆشتنەکان */
        background: var(--pu-input);
        border: 1px solid var(--border-card);
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px; /* وەک فرۆشتنەکان */
        cursor: pointer;
        transition: all .2s;
        text-decoration: none;
        gap: 4px; /* وەک فرۆشتنەکان */
    }

        .pg-btn:hover:not(:disabled) {
            background: var(--pu-hover);
            color: var(--accent);
            border-color: var(--accent);
        }

        .pg-btn.active {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
            cursor: default;
        }

        .pg-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .pg-dots {
        display: inline-flex;
        align-items: center;
        justify-content: center; /* وەک فرۆشتنەکان */
        padding: 0 4px;
        color: var(--text-dim);
        font-weight: bold;
    }

    /* ══ Empty state ══ */
    .pu-empty {
        text-align: center;
        padding: 30px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .pu-empty i {
            font-size: 24px;
            color: var(--text-dim);
            margin-bottom: 8px;
            opacity: .5;
        }

        .pu-empty h5 {
            color: var(--text-muted);
            margin: 0 0 4px;
            font-size: 13px;
        }

        .pu-empty p {
            color: var(--text-dim);
            font-size: 11px;
            margin: 0;
        }

    /* ══ Fullscreen ══ */
    .pu-card.is-fullscreen, .pu-card:-webkit-full-screen, .pu-card:fullscreen {
        position: fixed !important;
        inset: 0 !important;
        width: 100% !important;
        height: 100% !important;
        max-width: 100% !important;
        max-height: 100% !important;
        z-index: 2147483647 !important;
        border-radius: 0 !important;
        margin: 0 !important;
        padding: 16px !important; /* وەک فرۆشتنەکان 16px */
        background-color: var(--pu-page) !important;
        box-sizing: border-box !important;
        overflow-y: auto !important;
    }

    /* ══ مۆدال — گونجاندنی بۆ 12px چەماوەیی ══ */
    .pu-modal .modal-content {
        background: var(--pu-card);
        border: 1px solid var(--border-card);
        border-radius: 12px; /* گۆڕدرا بۆ 12px بۆ گونجان لەگەڵ دیزاینە نوێیەکە */
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,.3);
        color: var(--text-primary);
    }

    .pu-modal .modal-body {
        background: var(--pu-card);
    }

    .pu-modal .modal-footer {
        background: var(--pu-stat);
        border-top: 1px solid var(--border-subtle);
    }

    .pm-hdr {
        background: linear-gradient(135deg, rgba(99,102,241,.15), rgba(129,140,248,.1));
        border-bottom: 1px solid var(--accent-border);
        padding: 10px 14px; /* کەمێک گەورەتر کرا */
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .pm-hdr-ico {
        width: 30px;
        height: 30px;
        border-radius: 50%; /* بازنەیی وەک هێدەر */
        background: linear-gradient(135deg, #6366f1, #818cf8);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #fff;
        font-size: 13px;
    }

    .pm-hdr-title {
        font-size: 15px;
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.2;
    }

    .pm-hdr-sub {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 1px;
    }

    /* ══ فۆرمی ستونی ڕاست (مۆدال) ══ */
    .pm-form-side {
        width: 250px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        background: var(--pu-stat);
        overflow: hidden;
        border-right: 1px solid var(--border-subtle);
    }

    .pf-wrap {
        position: relative;
        margin-bottom: 8px; /* کەمێک زیادکرا */
    }

        .pf-wrap label {
            position: absolute;
            top: 6px;
            right: 8px;
            font-size: 10px;
            color: var(--text-dim);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .2px;
            pointer-events: none;
            transition: color .15s;
        }

        .pf-wrap input, .pf-wrap select {
            width: 100%;
            height: 38px; /* کەمێک زیادکرا */
            border: 1px solid var(--border-card);
            border-radius: 6px; /* وەک ئینپوتە نوێیەکان 6px */
            padding: 16px 8px 2px;
            font-size: 12px;
            outline: none;
            transition: border .15s;
            background: var(--pu-input);
            color: var(--text-primary);
            appearance: auto;
            font-family: inherit;
        }

            .pf-wrap input:focus, .pf-wrap select:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px var(--accent-bg);
            }

                .pf-wrap input:focus + label, .pf-wrap select:focus + label,
                .pf-wrap.has-val label {
                    color: var(--accent);
                }

        .pf-wrap.loss input {
            border-color: var(--danger) !important;
            background: var(--danger-bg);
        }

        .pf-wrap.loss label {
            color: var(--danger) !important;
        }

        .pf-wrap.readonly input {
            background: var(--accent-bg);
            color: var(--accent-text);
            font-weight: 700;
        }

    /* ══ ستونی لیست (مۆدال) ══ */
    .pm-list-side {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        background: var(--pu-card);
        overflow: hidden;
    }

    .pm-list-header {
        padding: 10px 14px;
        background: var(--pu-stat);
        border-bottom: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        flex-wrap: wrap;
    }

    /* ══ خشتەی کاڵاکانی مۆدال ══ */
    .pm-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .pm-tbl thead th {
            background: var(--accent-bg);
            color: var(--accent-text);
            font-weight: 700;
            font-size: 11px;
            padding: 6px 8px;
            border-bottom: 1px solid var(--accent-border);
            text-align: right;
            white-space: nowrap;
        }

        .pm-tbl tbody tr {
            border-bottom: 1px solid var(--border-subtle);
            cursor: pointer;
            transition: background .12s;
        }

            .pm-tbl tbody tr:hover {
                background: var(--pu-hover);
            }

            .pm-tbl tbody tr.active-row {
                background: var(--accent-bg) !important;
            }

        .pm-tbl tbody td {
            padding: 6px 8px;
            font-size: 11px;
            color: var(--text-secondary);
            vertical-align: middle;
            white-space: nowrap;
        }

        .pm-tbl .td-name {
            max-width: 120px;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 600;
            color: var(--accent-text);
        }

        .pm-tbl .td-barcode {
            color: var(--text-dim);
            font-size: 10px;
            font-family: monospace;
        }

        .pm-tbl .td-unit {
            color: var(--accent);
            font-weight: 600;
        }

        .pm-tbl .td-cost {
            color: var(--danger);
            font-weight: 700;
        }

        .pm-tbl .td-total {
            color: var(--success);
            font-weight: 700;
        }

        .pm-tbl .td-idx {
            color: var(--text-dim);
            font-size: 10px;
            font-weight: 600;
        }

        .pm-tbl .td-num {
            font-weight: 700;
            font-family: monospace;
            color: var(--text-primary);
        }

    /* ══ دووگمەی سڕینەوەی ڕیز ══ */
    .btn-del-row {
        width: 24px;
        height: 24px;
        border: none;
        border-radius: 6px;
        background: var(--danger-bg);
        color: var(--danger);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        transition: all .15s;
        flex-shrink: 0;
    }

        .btn-del-row:hover {
            background: var(--danger);
            color: #fff;
        }

    /* ══ قازانج/زەرەر pill ══ */
    .pm-pill {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        padding: 2px 4px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 700;
    }

        .pm-pill.g {
            background: var(--success-bg);
            color: var(--success);
        }

        .pm-pill.l {
            background: var(--danger-bg);
            color: var(--danger);
        }

        .pm-pill.z {
            background: rgba(148,163,184,.06);
            color: var(--text-dim);
        }

    /* ══ profit bar ══ */
    .pm-profit-bar {
        border-radius: 6px; /* گۆڕدرا بۆ 6px */
        padding: 6px 10px;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 11px;
        font-weight: 700;
    }

        .pm-profit-bar.gain {
            background: var(--success-bg);
            color: var(--success);
            border: 1px solid rgba(52,211,153,.2);
        }

        .pm-profit-bar.loss {
            background: var(--danger-bg);
            color: var(--danger);
            border: 1px solid rgba(251,113,133,.2);
        }

        .pm-profit-bar.zero {
            background: rgba(148,163,184,.06);
            color: var(--text-dim);
            border: 1px solid var(--border-subtle);
        }

        .pm-profit-bar.hidden {
            display: none;
        }

    /* ══ دوگمەی زیادکردن ══ */
    .pm-do-add {
        width: 100%;
        background: linear-gradient(135deg, #6366f1, #818cf8);
        color: #fff;
        border: none;
        border-radius: 6px; /* گۆڕدرا بۆ 6px */
        padding: 0;
        height: 34px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all .18s;
        margin-top: 4px;
        font-family: inherit;
    }

        .pm-do-add:hover {
            box-shadow: 0 4px 12px rgba(99,102,241,.3); /* گەورەتر کرا */
        }

        .pm-do-add.green {
            background: linear-gradient(135deg, #059669, #10b981);
        }

            .pm-do-add.green:hover {
                box-shadow: 0 4px 12px rgba(16,185,129,.3);
            }

    /* ══ ئاماری خوارەوەی مۆدال ══ */
    .pm-stats-bar {
        flex-shrink: 0;
        border-top: 1px solid var(--accent-border);
        background: var(--pu-stat);
        padding: 10px 14px;
        display: flex;
        gap: 0;
        direction: rtl;
    }

    .pm-stat-item {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 10px;
        border-left: 1px solid var(--border-subtle);
    }

        .pm-stat-item:last-child {
            border-left: none;
        }

    .pm-stat-ico {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .pm-stat-lbl {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 600;
        margin-bottom: 0;
    }

    .pm-stat-val {
        font-size: 15px;
        font-weight: 800;
        line-height: 1;
        margin-top: 2px;
    }

    /* ══ فووتەری مۆدال ══ */
    .pm-footer {
        padding: 10px 14px;
        background: var(--pu-stat);
        border-top: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .pm-btn-cancel {
        background: var(--pu-input);
        color: var(--text-secondary);
        border: 1px solid var(--border-card);
        border-radius: 6px; /* 6px */
        height: 32px;
        padding: 0 14px;
        font-size: 12px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        transition: all .15s;
        font-family: inherit;
    }

    .pm-btn-save {
        background: linear-gradient(135deg, #059669, #10b981);
        color: #fff;
        border: none;
        border-radius: 6px; /* 6px */
        height: 32px;
        padding: 0 18px;
        font-weight: 700;
        font-size: 12px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .18s;
        box-shadow: 0 2px 6px rgba(16,185,129,.25);
        font-family: inherit;
    }

    /* ══ ستۆک chip ══ */
    .pm-stock-chip {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        color: var(--text-dim);
        margin-top: 4px;
        padding: 4px 8px;
        background: var(--pu-stat);
        border-radius: 6px;
        border: 1px solid var(--border-card);
    }

        .pm-stock-chip .num {
            font-weight: 700;
            color: var(--info);
        }

            .pm-stock-chip .num.low {
                color: var(--warning);
            }

            .pm-stock-chip .num.out {
                color: var(--danger);
            }

    /* ══ پەیامەکان ══ */
    .pm-msg-ok {
        color: var(--success);
        font-size: 11px;
        padding: 2px 0;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .pm-msg-err {
        color: var(--danger);
        font-size: 11px;
        padding: 2px 0;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .pm-msg-inf {
        color: var(--info);
        font-size: 11px;
        padding: 2px 0;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* ══ بەتاڵ (مۆدال) ══ */
    .pm-empty {
        text-align: center;
        padding: 30px 20px;
        color: var(--text-dim);
    }

        .pm-empty i {
            font-size: 24px;
            display: block;
            margin-bottom: 6px;
            color: var(--text-dim);
            opacity: .3;
        }

        .pm-empty p {
            font-size: 12px;
            margin: 0;
        }

    /* ══ نرخی تاک و جوملە ══ */
    .pm-price-info {
        background: var(--accent-bg);
        border: 1px solid var(--accent-border);
        border-radius: 6px; /* 6px */
        padding: 6px 8px;
        margin-top: 6px;
    }

        .pm-price-info .lbl {
            font-size: 10px;
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 2px;
        }

        .pm-price-info .val {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-primary);
        }

    /* ══ Delete modal ══ */
    .del-warning {
        text-align: center;
        padding: 14px;
        background: var(--danger-bg);
        border: 1px solid rgba(251,113,133,.15);
        border-radius: 8px;
        margin-bottom: 12px;
    }

        .del-warning i {
            font-size: 26px;
            color: var(--danger);
        }

        .del-warning h5 {
            color: var(--danger);
            font-weight: 700;
            margin: 6px 0 2px;
            font-size: 14px;
        }

        .del-warning p {
            color: var(--text-secondary);
            font-size: 11px;
            margin: 0;
        }

    .del-info {
        display: flex;
        gap: 8px;
        padding: 12px;
        background: var(--pu-stat);
        border: 1px solid var(--border-card);
        border-radius: 8px;
    }

        .del-info .item {
            flex: 1;
            text-align: center;
        }

        .del-info .label {
            font-size: 11px;
            color: var(--text-dim);
            margin-bottom: 4px;
        }

        .del-info .value {
            font-weight: 700;
            font-size: 13px;
            color: var(--text-primary);
        }

            .del-info .value.success {
                color: var(--success);
            }

    /* ══ Responsive ══ */
    @@media(max-width:1200px) {
        .pu-stats {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media(max-width:768px) {
        .pu-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .pu-toolbar {
            flex-direction: column;
            align-items: stretch;
        }
        /* وەک فرۆشتنەکان ستوونی کرا */
        .pagination-bar {
            flex-direction: column;
            align-items: center;
        }
    }

    @@media(max-width:576px) {
        .pu-stats {
            grid-template-columns: 1fr;
        }

        .pu-in {
            padding: 12px;
        }
    }
</style>

<!-- ══════════════════════════════════════════════════════════════ -->
<!-- HTML بۆدی -->
<!-- ══════════════════════════════════════════════════════════════ -->

<div class="pu-page">
    <div class="pu-in">

        <!-- ══ هێدەر ══ -->
        <div class="pu-top">
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="pu-top-ico"><i class="bi bi-truck"></i></div>
                <div>
                    <h1>کڕینەکان</h1>
                    <p>پسوڵەکانی کڕین و بەڕێوەبردنی دابینکەران</p>
                </div>
            </div>

            <!-- ══ دوگمەی نوێ بە دیزاینی مۆدێرن ══ -->
            <div>
                <!-- بەکارهێنانی کڵاسە نوێیەکان لێرە -->
                <button type="button" class="btn-act-main btn-act-primary" data-bs-toggle="modal" data-bs-target="#purchaseModal" onclick="resetPurchaseModal()">
                    <i class="bi bi-plus-lg"></i>
                    کڕینی نوێ
                </button>
            </div>
        </div>

        <!-- ══ ٣ کارتی ئامار ══ -->
        <div class="pu-stats">
            <div class="pu-st">
                <div><div class="pu-st-lbl">پسوڵەکان</div><div class="pu-st-val c-indigo" id="statInvoices">@Model.TotalInvoices</div><div class="pu-st-sub">دانە</div></div>
                <div class="pu-st-ico bg-indigo"><i class="bi bi-receipt"></i></div>
            </div>
            <div class="pu-st">
                <div><div class="pu-st-lbl">کۆی تێچوو</div><div class="pu-st-val c-cyan" id="statPurchases">@string.Format("{0:N0}", Model.TotalPurchases)</div><div class="pu-st-sub">دینار</div></div>
                <div class="pu-st-ico bg-cyan"><i class="bi bi-cash-stack"></i></div>
            </div>
            <div class="pu-st">
                <div><div class="pu-st-lbl">جۆری کاڵا</div><div class="pu-st-val c-info" id="statProducts">@Model.TotalProducts</div><div class="pu-st-sub">دانە</div></div>
                <div class="pu-st-ico bg-info-c"><i class="bi bi-grid-3x3-gap"></i></div>
            </div>
        </div>

        <!-- ══ کارتی خشتە ══ -->
        <div class="pu-card" id="mainCard">

            <!-- تولبار -->
            <div class="pu-toolbar">
                <div style="display:flex;align-items:center;gap:8px; flex: 1; flex-wrap: wrap;">
                    <!-- گەڕان -->
                    <div style="display:flex;align-items:center;gap:6px;">
                        <input type="text" id="fInvoice" class="pu-inp" placeholder="ژمارەی پسوڵە..." style="width:120px;">
                    </div>

                    <!-- ماوە: hidden select بۆ backend + دوگمەگرووپ -->
                    @{
                        var fdr = Model.FilterDateRange ?? "Today";
                    }
                    <select id="fDateRange" style="display:none;">
                        <option value="Today" @@(fdr =="Today" ?"selected":"")>ئەمڕۆ</option>
                        <option value="Week" @@(fdr =="Week" ?"selected":"")>ئەم هەفتەیە</option>
                        <option value="Month" @@(fdr =="Month" ?"selected":"")>ئەم مانگە</option>
                        <option value="Custom" @@(fdr =="Custom" ?"selected":"")>بەروار</option>
                    </select>

                    <div class="rc-btn-group" id="dateRangeBtns">
                        <button type="button" data-val="Today" class="@(fdr == "Today" ? "active" : "")">ئەمڕۆ</button>
                        <button type="button" data-val="Week" class="@(fdr == "Week" ? "active" : "")">ئەم هەفتەیە</button>
                        <button type="button" data-val="Month" class="@(fdr == "Month" ? "active" : "")">ئەم مانگە</button>
                        <button type="button" data-val="Custom" class="@(fdr == "Custom" ? "active" : "")"><i class="bi bi-calendar3"></i> بەروار</button>
                    </div>

                    <!-- بەرواری دەستی -->
                    <div id="fCustomDates" style="display:@(fdr == "Custom" ? "flex" : "none");align-items:center;gap:6px;">
                        <input type="date" id="fStartDate" class="pu-inp" style="width:115px;"
                               value="@(Model.StartDate.HasValue? Model.StartDate.Value.ToString("yyyy-MM-dd") : "")">
                        <span style="font-size:12px;color:var(--text-dim);">→</span>
                        <input type="date" id="fEndDate" class="pu-inp" style="width:115px;"
                               value="@(Model.EndDate.HasValue? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")">
                    </div>

                    <i class="bi bi-arrow-repeat" id="filterSpinner" style="display:none;color:var(--accent);font-size:14px;animation:spin .8s linear infinite;"></i>

                    <!-- پاڵنانی ئەنجامەکان و فۆل سکرین بۆ لای چەپ -->
                    <div style="margin-right:auto; display:flex; align-items:center; gap: 10px;">
                        <span id="filterResultCount" style="font-size:12px;color:var(--text-dim);font-weight:600;">@Model.TotalFilteredCount پسوڵە</span>
                        <button class="pu-btn pu-btn-ghost" onclick="toggleFullscreen()" title="گەورەکردن" style="padding:0 8px;">
                            <i class="bi bi-arrows-fullscreen" id="expandIcon"></i>
                        </button>
                    </div>
                </div>
            </div>
            <style>
                @@keyframes spin {
                    to {
                        transform: rotate(360deg);
                    }
                }</style>

            <!-- ══ خشتەی پسوڵەکان ══ -->
            <div id="content-purchase" style="display:flex;flex-direction:column;flex:1;min-height:0;">
                @if (Model.PurchaseList.Any())
                {
                    <div class="pu-tbl-scroll">
                        <table class="pu-tbl">
                            <thead>
                                <tr>
                                    <th style="width:4%;text-align:center;">#</th>
                                    <th style="width:8%">پسوڵە</th>
                                    <th style="width:13%">بەروار</th>
                                    <th style="width:14%">دابینکەر</th>
                                    <th>کاڵاکان</th>
                                    <th style="width:7%;text-align:center;">جۆر</th>
                                    <th style="width:8%;text-align:center;">کۆی بڕ</th>
                                    <th style="width:12%;text-align:center;">کۆی تێچوو</th>
                                    <th style="width:9%;text-align:center;">کردار</th>
                                </tr>
                            </thead>
                            <tbody id="purchaseTbody">
                                @{
                                    int rn = 1;
                                }
                                @foreach (var item in Model.PurchaseList)
                                {
                                    <tr data-id="@item.PurchaseId" style="cursor:pointer;" data-date="@item.PurchaseDate.ToString("yyyy-MM-dd")" data-invoice="@item.PurchaseId">
                                        <td style="text-align:center;color:var(--text-dim);font-weight:500;">@rn</td>
                                        <td><span style="color:var(--accent-text);font-weight:700;">#@item.PurchaseId</span></td>
                                        <td>
                                            <span style="font-weight:600;">@item.PurchaseDate.ToString("yyyy/MM/dd")</span>
                                            <span style="color:var(--text-dim);margin-right:6px;font-size:11px;">@item.PurchaseDate.ToString("HH:mm")</span>
                                        </td>
                                        <td>
                                            @if (item.SupplierId == 1)
                                            {
                                                <span style="color:var(--text-dim);">—</span>
                                            }
                                            else
                                            {
                                                <span class="pu-badge supplier"><i class="bi bi-building"></i> @item.SupplierName</span>
                                            }
                                        </td>
                                        <td>
                                            @foreach (var detail in item.Items.Take(2))
                                            {
                                                <span class="pu-badge product">@detail.ProductName</span>
                                            }
                                            @if (item.Items.Count > 2)
                                            {
                                                <span class="pu-badge more">+@(item.Items.Count - 2) تر</span>
                                            }
                                            @if (!item.Items.Any())
                                            {
                                                <span style="color:var(--text-dim);">—</span>
                                            }
                                        </td>
                                        <td style="text-align:center;font-weight:600;">@item.ItemCount</td>
                                        <td style="text-align:center;font-weight:600;">@item.TotalQuantity</td>
                                        <td style="text-align:center;font-weight:700;">@string.Format("{0:N0}", item.TotalAmount)</td>
                                        <td style="text-align:center;">
                                            <div style="display:flex;gap:6px;justify-content:center;">
                                                <button type="button" class="act-btn edit edit-btn" data-id="@item.PurchaseId" title="دەستکاری"><i class="bi bi-pencil"></i></button>
                                                <button type="button" class="act-btn delete delete-btn" data-id="@item.PurchaseId" data-total="@item.TotalAmount" data-date="@item.PurchaseDate.ToString("yyyy/MM/dd HH:mm")" data-count="@item.Items.Count" title="سڕینەوە"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                    rn++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="pu-empty">
                        <i class="bi bi-receipt"></i>
                        <h5>هیچ پسوڵەیەک نییە</h5>
                        <p>پسوڵەی کڕینی نوێ زیاد بکە</p>
                    </div>
                }
                @if (Model.TotalFilteredCount > 0)
                {
                    <div class="pagination-bar" id="pgBar">
                        <span class="pg-info" id="pgInfo"></span>
                        <span style="font-size:12px;color:var(--text-dim);display:flex;align-items:center;gap:4px;"><i class="bi bi-hand-index-thumb"></i> دوو جار کلیک بکە بۆ وردەکاری</span>
                        <div class="pg-controls" id="pgBtns"></div>
                    </div>
                    <script>
                        var _pgData = {
                            current: @Model.CurrentPage,
                            total: @Model.TotalPages,
                            filtered: @Model.TotalFilteredCount,
                            pageSize: @IndexModel.PageSize
                        };
                        var _statsData = {
                            invoices: @Model.TotalInvoices,
                            purchases: @((long)Model.TotalPurchases),
                            products: @Model.TotalProducts
                        };
                    </script>
                }
            </div>
        </div><!-- /pu-card -->

    </div>
</div>

