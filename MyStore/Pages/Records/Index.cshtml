@page
@model MyStore.Pages.Records.IndexModel
@{
    ViewData["Title"] = "تۆمارکردنەکان";
    var t = Model.ActiveTab ?? "p";
    // ئەگەر کشێر بێت و هەوڵبدات بچێتە تابی دابینکەر، دەیگەڕێنینەوە بۆ کاڵاکان
    if (Model.IsCashier && t == "s") t = "p";
}

<style>
    /* ══ هێنانی فۆنتەکە ══ */
    @@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap');

    main, .container, .container-fluid, .p-3, .p-4, .pb-3, .content-wrapper, .body-content {
        padding: 0 !important;
    }

    footer {
        display: none !important;
    }

    /* ══ تاریک ══ */
    :root {
        --rc-page: #0b1120;
        --rc-card: rgba(15,23,42,.7);
        --rc-stat: rgba(15,23,42,.6);
        --rc-thead: rgba(15,23,42,.5);
        --rc-hover: rgba(99,102,241,.04);
        --rc-input: rgba(30,41,59,.8);
        --border-card: rgba(148,163,184,.08);
        --border-subtle: rgba(148,163,184,.06);
        --border-input: rgba(148,163,184,.12);
        --border-focus: rgba(129,140,248,.5);
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --text-dim: #475569;
        --accent: #818cf8;
        --accent-text: #a5b4fc;
        --accent-bg: rgba(99,102,241,.12);
        --accent-border: rgba(99,102,241,.2);
        --success: #6ee7b7;
        --success-bg: rgba(52,211,153,.1);
        --danger: #fda4af;
        --danger-bg: rgba(251,113,133,.1);
        --warning: #fcd34d;
        --warning-bg: rgba(252,211,77,.1);
        --info: #93c5fd;
        --info-bg: rgba(59,130,246,.1);
        --cyan: #67e8f9;
        --cyan-bg: rgba(6,182,212,.1);
        --gradient-top: linear-gradient(135deg,rgba(30,27,75,.4),rgba(49,46,129,.3),rgba(30,27,75,.2));
        --shadow-sm: none;
    }

    /* ══ ڕووناک ══ */
    [data-theme="light"] {
        --rc-page: #eef1f6;
        --rc-card: #ffffff;
        --rc-stat: #ffffff;
        --rc-thead: #f8f9fb;
        --rc-hover: rgba(99,102,241,.03);
        --rc-input: #ffffff;
        --border-card: #dde0e7;
        --border-subtle: #eaecf0;
        --border-input: rgba(0,0,0,.12);
        --border-focus: rgba(99,102,241,.45);
        --text-primary: #111827;
        --text-secondary: #374151;
        --text-muted: #4b5563;
        --text-dim: #6b7280;
        --accent: #6366f1;
        --accent-text: #4338ca;
        --accent-bg: rgba(99,102,241,.06);
        --accent-border: rgba(99,102,241,.12);
        --success: #047857;
        --success-bg: rgba(4,120,87,.08);
        --danger: #be123c;
        --danger-bg: rgba(190,18,60,.06);
        --warning: #b45309;
        --warning-bg: rgba(217,119,6,.08);
        --info: #2563eb;
        --info-bg: rgba(59,130,246,.08);
        --cyan: #0891b2;
        --cyan-bg: rgba(6,182,212,.08);
        --gradient-top: linear-gradient(135deg,rgba(238,242,255,.95),rgba(224,231,255,.7),rgba(238,242,255,.5));
        --shadow-sm: 0 1px 3px rgba(0,0,0,.06);
    }

    /* ══ ڕێکخستنی بنەڕەتی ══ */
    .rc-page {
        direction: rtl;
        font-family: 'IBM Plex Sans Arabic', sans-serif;
        background: var(--rc-page);
        color: var(--text-primary);
        min-height: 100vh;
        position: relative;
        transition: background .35s, color .35s;
    }

        .rc-page::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 260px;
            background: var(--gradient-top);
            pointer-events: none;
            transition: background .35s;
        }

    .rc-in {
        position: relative;
        z-index: 1;
        padding: 20px 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: 100vh;
    }

    /* ══ هێدەر ══ */
    .rc-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        flex-shrink: 0;
    }

        .rc-top h1 {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 2px;
        }

        .rc-top p {
            font-size: 11px;
            color: var(--text-muted);
            margin: 0;
        }

    .rc-top-ico {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg,#6366f1,#818cf8);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #fff;
        font-size: 14px;
    }

    /* ══ تابەکانی هێدەر (دیزاینی نوێ و بچووککراوە) ══ */
    .header-tabs {
        display: flex;
        gap: 16px;
        background: transparent;
        padding: 0;
        border: none;
    }

    .ht-tab {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 4px;
        border: none;
        border-radius: 0;
        cursor: pointer;
        background: transparent !important;
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 500;
        transition: all 0.2s;
        font-family: inherit;
        position: relative;
    }

        .ht-tab:hover {
            color: var(--text-primary);
        }

        .ht-tab.active {
            color: var(--accent);
            font-weight: 600;
        }

        .ht-tab::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 2px;
            background: transparent;
            border-radius: 2px 2px 0 0;
            transition: background 0.2s;
        }

        .ht-tab.active::after {
            background: var(--accent);
        }

        .ht-tab .cnt {
            font-size: 9px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 20px;
            background: rgba(148,163,184,.1);
            color: inherit;
            transition: all 0.3s;
        }

        .ht-tab.active .cnt {
            background: var(--accent-bg);
            color: var(--accent);
        }

    /* ══ دوگمەی سەرەکی ══ */
    .btn-act-primary {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 32px;
        padding: 0 16px;
        border-radius: 8px;
        border: none;
        color: #ffffff !important;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
        overflow: hidden;
        font-family: inherit;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

        .btn-act-primary i {
            font-size: 14px;
        }

        .btn-act-primary::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
            transform: skewX(-20deg);
            transition: left 0.5s ease;
        }

        .btn-act-primary:hover {
            transform: translateY(-2px);
        }

            .btn-act-primary:hover::after {
                left: 150%;
            }

    .btn-p {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

        .btn-p:hover {
            box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
        }

    .btn-c {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
    }

        .btn-c:hover {
            box-shadow: 0 6px 16px rgba(245, 158, 11, 0.35);
        }

    .btn-s {
        background: linear-gradient(135deg, #059669, #10b981);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }

        .btn-s:hover {
            box-shadow: 0 6px 16px rgba(16, 185, 129, 0.35);
        }

    /* ══ کارتی ئامار (ڕێک وەک دەفتەری قەرزەکان) ══ */
    .rc-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        flex-shrink: 0;
    }

    .rc-st {
        background: var(--rc-stat);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        padding: 14px 16px;
        transition: all .35s;
        box-shadow: var(--shadow-sm);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

        .rc-st:hover {
            border-color: var(--accent-border);
            transform: translateY(-1px);
        }

    .rc-st-lbl {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 400;
        margin-bottom: 6px;
    }

    .rc-st-val {
        font-size: 22px;
        font-weight: 600;
        line-height: 1;
        transition: color .35s;
    }

    .rc-st-sub {
        font-size: 11px;
        color: var(--text-dim);
        margin-top: 4px;
    }

    .rc-st-ico {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .c-indigo {
        color: var(--accent-text);
    }

    .bg-indigo {
        background: var(--accent-bg);
        color: var(--accent);
    }

    .c-emerald {
        color: var(--success);
    }

    .bg-emerald {
        background: var(--success-bg);
        color: var(--success);
    }

    .c-rose {
        color: var(--danger);
    }

    .bg-rose {
        background: var(--danger-bg);
        color: var(--danger);
    }

    .c-amber {
        color: var(--warning);
    }

    .bg-amber {
        background: var(--warning-bg);
        color: var(--warning);
    }

    .c-info {
        color: var(--info);
    }

    .bg-info-c {
        background: var(--info-bg);
        color: var(--info);
    }

    /* ══ کارتی سەرەکی ══ */
    .tbl-card {
        background: var(--rc-card);
        border: 1px solid var(--border-card);
        border-radius: 14px;
        overflow: hidden;
        transition: all .35s;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
        position: relative;
    }

    .tab-panel {
        display: none;
        flex: 1;
        min-height: 0;
        flex-direction: column;
    }

        .tab-panel.active {
            display: flex;
        }

    /* ══ تولبار ══ */
    .rc-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 14px;
        border-bottom: 1px solid var(--border-subtle);
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    .rc-inp {
        height: 32px;
        padding: 0 10px;
        background: var(--rc-input);
        border: 1px solid var(--border-input);
        border-radius: 6px;
        color: var(--text-primary);
        font-size: 11px;
        font-family: inherit;
        outline: none;
        transition: all .25s;
    }

        .rc-inp:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px var(--accent-bg);
        }

        .rc-inp::placeholder {
            color: var(--text-dim);
            opacity: .7;
        }

    .rc-btn {
        height: 32px;
        padding: 0 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        transition: all .2s;
        border: none;
        text-decoration: none;
    }

    .rc-btn-ghost {
        background: var(--rc-input);
        color: var(--text-secondary);
        border: 1px solid var(--border-card);
    }

        .rc-btn-ghost:hover {
            background: var(--rc-hover);
            color: var(--text-primary);
        }

    /* ══ خشتە و سکڕۆڵ ══ */
    * {
        scrollbar-width: thin;
        scrollbar-color: var(--text-muted) var(--rc-card);
    }

    .table-scroll {
        flex: 1;
        overflow: auto;
        min-height: 0;
    }

        .table-scroll::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .table-scroll::-webkit-scrollbar-track {
            background: var(--rc-card);
        }

        .table-scroll::-webkit-scrollbar-thumb {
            background: var(--text-dim);
            border-radius: 6px;
        }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 640px;
    }

        .data-table th {
            padding: 10px 14px;
            text-align: right;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            background: var(--rc-thead);
            border-bottom: 1px solid var(--border-subtle);
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 1;
            transition: all .35s;
        }

        .data-table td {
            padding: 8px 14px;
            font-size: 12px;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-subtle);
            vertical-align: middle;
            transition: all .35s;
            white-space: nowrap;
        }

        .data-table tbody tr {
            transition: background .15s;
        }

            .data-table tbody tr:hover {
                background: var(--rc-hover);
            }

            .data-table tbody tr:last-child td {
                border-bottom: none;
            }

            .data-table tbody tr.archived td {
                opacity: .5;
            }

    /* ══ باجەکان (Badges) ══ */
    .bso {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: var(--success-bg);
        color: var(--success);
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
    }

    .bsl {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: var(--warning-bg);
        color: var(--warning);
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
    }

    .bsz {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: var(--danger-bg);
        color: var(--danger);
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
    }

    .b-on {
        background: var(--success-bg);
        color: var(--success);
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
    }

    .b-off {
        background: rgba(148,163,184,.08);
        color: var(--text-dim);
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
    }

    .b-bp {
        background: var(--danger-bg);
        color: var(--danger);
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
    }

    .b-bn {
        background: var(--danger-bg);
        color: var(--danger);
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
    }

    .b-bz {
        background: rgba(148,163,184,.08);
        color: var(--text-dim);
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
    }

    .b-cnt {
        background: var(--info-bg);
        color: var(--info);
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
    }

    .unit-chips {
        display: flex;
        gap: 3px;
        flex-wrap: wrap;
    }

    .uc {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
        white-space: nowrap;
    }

    .uc-k {
        background: var(--info-bg);
        color: var(--info);
    }

    .uc-d {
        background: var(--accent-bg);
        color: var(--accent-text);
    }

    .uc-b {
        background: var(--warning-bg);
        color: var(--warning);
    }

    .profit-pos {
        color: var(--success);
        font-weight: 700;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    /* ══ دوگمەکانی ناو خشتە ══ */
    .act-grp {
        display: flex;
        gap: 4px;
        justify-content: center;
    }

    .act-btn {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        transition: all .2s;
        cursor: pointer;
        background: transparent;
    }

    .ab-e {
        color: var(--info);
        background: var(--info-bg);
        border-color: rgba(59, 130, 246, 0.2);
    }

        .ab-e:hover {
            background: var(--info);
            color: #fff;
        }

    .ab-d {
        color: var(--danger);
        background: var(--danger-bg);
        border-color: rgba(251,113,133,0.2);
    }

        .ab-d:hover {
            background: var(--danger);
            color: #fff;
        }

    .act-btn:disabled {
        opacity: .3;
        cursor: not-allowed;
    }

    /* ══ لۆدینگ ══ */
    .tbl-loading {
        display: none;
        position: absolute;
        inset: 0;
        background: rgba(11,17,32,.5);
        z-index: 10;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }

    [data-theme="light"] .tbl-loading {
        background: rgba(255,255,255,.7);
    }

    .tbl-loading.show {
        display: flex;
    }

    .spin {
        width: 28px;
        height: 28px;
        border: 3px solid var(--border-card);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin .7s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .tbl-wrap-rel {
        position: relative;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: var(--text-dim);
    }

        .empty-state i {
            font-size: 3rem;
            display: block;
            margin-bottom: 10px;
            opacity: .4;
        }

    /* ══ Fullscreen ══ */
    .tbl-card.is-fullscreen {
        position: fixed !important;
        inset: 0 !important;
        z-index: 2147483647 !important;
        border-radius: 0 !important;
        background-color: var(--rc-page) !important;
        padding: 16px !important;
    }

        .tbl-card.is-fullscreen .table-scroll {
            flex: 1;
            max-height: none !important;
        }

    /* ══ مۆدالەکان ══ */
    .rc-modal .modal-content {
        background: var(--rc-card);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        overflow: hidden;
        color: var(--text-primary);
        box-shadow: 0 15px 35px rgba(0,0,0,.3);
    }

    .rc-modal .modal-body {
        background: var(--rc-card);
        padding: 20px;
    }

    .rc-modal .modal-footer {
        background: var(--rc-stat);
        border-top: 1px solid var(--border-subtle);
        padding: 12px 20px;
    }

    .mh-pu {
        background: linear-gradient(135deg, rgba(99,102,241,.12), rgba(129,140,248,.08));
        border-bottom: 1px solid var(--accent-border);
        padding: 15px 20px;
    }

    .mh-am {
        background: linear-gradient(135deg, rgba(252,211,77,.15), rgba(217,119,6,.1));
        border-bottom: 1px solid rgba(252,211,77,.15);
        padding: 15px 20px;
    }

    .mh-gr {
        background: linear-gradient(135deg, rgba(52,211,153,.12), rgba(4,120,87,.08));
        border-bottom: 1px solid rgba(52,211,153,.15);
        padding: 15px 20px;
    }

    .mh-re {
        background: linear-gradient(135deg, rgba(251,113,133,.15), rgba(190,18,60,.1));
        border-bottom: 1px solid rgba(251,113,133,.15);
        padding: 15px 20px;
    }

    .modal-header {
        border: none;
    }

        .modal-header .modal-title {
            color: var(--text-primary);
            font-weight: 800;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .modal-header .btn-close {
            filter: var(--close-filter,invert(1));
            opacity: .6;
            font-size: 12px;
        }

    .f-wrap {
        position: relative;
        margin-bottom: 10px;
    }

        .f-wrap label {
            position: absolute;
            top: 7px;
            right: 10px;
            font-size: 9px;
            color: var(--text-dim);
            font-weight: 700;
            text-transform: uppercase;
            pointer-events: none;
        }

        .f-wrap input, .f-wrap textarea {
            width: 100%;
            border: 1px solid var(--border-card);
            border-radius: 8px;
            padding: 22px 10px 8px;
            font-size: 12px;
            outline: none;
            transition: border .15s;
            background: var(--rc-input);
            color: var(--text-primary);
            font-family: inherit;
            resize: none;
        }

            .f-wrap input:focus, .f-wrap textarea:focus {
                border-color: var(--border-focus);
                box-shadow: 0 0 0 3px var(--accent-bg);
            }

    .barcode-wrap {
        position: relative;
    }

    .btn-gen-barcode {
        position: absolute;
        left: 6px;
        bottom: 6px;
        height: 24px;
        background: var(--accent-bg);
        color: var(--accent);
        border: none;
        border-radius: 6px;
        padding: 0 8px;
        font-size: 10px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        z-index: 5;
    }

        .btn-gen-barcode:hover {
            background: var(--accent);
            color: #fff;
        }

    .f-wrap.has-btn input {
        padding-left: 90px;
    }

    .f-r2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .f-r3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
    }

    .f-full {
