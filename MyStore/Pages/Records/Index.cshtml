@section Scripts {
    <script>
        const _tok = () => document.querySelector('input[name="__RequestVerificationToken"]').value;
        const _$ = id => document.getElementById(id);

        // دەستنیشانکردنی ئەوەی داخۆ بەکارهێنەر کشێرە
        const _isCashier = @Model.IsCashier.ToString().ToLower();

        let _act = null;
        let _curTab = '@t';

        const _state = {
          p: { q: '@(Model.SearchP ?? "")' },
          c: { q: '@(Model.SearchC ?? "")' },
          s: { q: '@(Model.SearchS ?? "")' }
        };

        // ══ فەنکشنی دروستکردنی باڕکۆد ══
        function generateProdBarcode() {
            var randomDigits = Math.floor(100000000 + Math.random() * 900000000);
            _$('prod-barcode').value = "200" + randomDigits;
            _$('prod-barcode').focus();
        }

        function toggleFs(id) {
          const card = _$(id); if (!card) return;
          if (!document.fullscreenElement && !document.webkitFullscreenElement) {
            if (card.requestFullscreen) card.requestFullscreen();
            else if (card.webkitRequestFullscreen) card.webkitRequestFullscreen();
          } else {
            if (document.exitFullscreen) document.exitFullscreen();
            else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
          }
        }

        document.addEventListener('fullscreenchange', () => {
          const card = _$('main-card');
          const icons = [_$('fsIcon-p'), _$('fsIcon-c'), _$('fsIcon-s')];
          if (document.fullscreenElement === card) {
              card.classList.add('is-fullscreen');
              icons.forEach(i => { if(i) i.className = 'bi bi-fullscreen-exit'; });
          } else {
              card.classList.remove('is-fullscreen');
              icons.forEach(i => { if(i) i.className = 'bi bi-arrows-fullscreen'; });
          }
        });

        function showMsg(id,txt,ok){const e=_$(id);if(e)e.innerHTML=txt?`<span style="color:${ok?'var(--success)':'var(--danger)'}">${txt}</span>`:''}

        function switchTab(t){
          const tabs = _isCashier ? ['p','c'] : ['p','c','s'];
          tabs.forEach(x=>{
              const tabBtn = _$('tab-'+x);
              const panel = _$('panel-'+x);
              const stats = _$('stats-'+x);
              if(tabBtn) tabBtn.classList.remove('active');
              if(panel) panel.classList.remove('active');
              if(stats) stats.style.display = 'none';
          });

          const actTab = _$('tab-'+t);
          const actPanel = _$('panel-'+t);
          const actStats = _$('stats-'+t);

          if(actTab) actTab.classList.add('active');
          if(actPanel) actPanel.classList.add('active');
          if(actStats) actStats.style.display = 'grid';
          _curTab=t;
        }

        let _timers = {};
        function onSearch(tab) {
          const q = _$('srch-'+tab).value;
          _$('clr-'+tab).style.display = q ? 'inline-flex' : 'none';
          clearTimeout(_timers[tab]);
          _timers[tab] = setTimeout(() => loadTab(tab, q), 350);
        }
        function clearSearch(tab) { _$('srch-'+tab).value = ''; _$('clr-'+tab).style.display = 'none'; loadTab(tab, ''); }

        let _stockFilter = 'all';
        function setStockFilter(f) { _stockFilter = f; loadTab('p'); }

        async function refreshStats() {
          try {
            const d = await (await fetch('?handler=StatsAjax')).json();
            if (!d || !d.success) return;
          } catch(e) { console.warn('refreshStats:', e); }
        }

        async function loadTab(tab, q) {
          if (q === undefined) q = _$('srch-'+tab)?.value || '';
          _state[tab] = { q };

          const loader = _$('load-'+tab); if (loader) loader.classList.add('show');
          const handler = tab==='p'?'ProductsAjax':tab==='c'?'CustomersAjax':'SuppliersAjax';
          const sf = (tab === 'p' && _stockFilter !== 'all') ? `&stockFilter=${_stockFilter}` : '';

          const url = `?handler=${handler}&q=${encodeURIComponent(q)}${sf}`;

          let d;
          try {
              const r = await fetch(url);
              const txt = await r.text();
              try { d = JSON.parse(txt); } catch(e) { return; }
          } catch(e) {
              if (loader) loader.classList.remove('show');
              return;
          }

          if (loader) loader.classList.remove('show');
          if (!d || !d.success) return;

          const total = d.total || 0;
          const rowData = d.rows || [];
          _state[tab] = { q };

          renderRows(tab, rowData, 1);
          const cntE = _$('cnt-'+tab);
          if (cntE) cntE.textContent = total;

          const scr = _$('panel-'+tab)?.querySelector('.table-scroll'); if (scr) scr.scrollTop = 0;
        }

        // بارکردنی داتا بەپێی دەسەڵات
        const initialTabs = _isCashier ? ['p','c'] : ['p','c','s'];
        initialTabs.forEach(t => loadTab(t));

        function renderRows(tab, rows, startIdx) {
          const tbody = _$('tbody-'+tab);
          if(!tbody) return;

          if (!rows.length) {
              const icon=tab==='p'?'box':tab==='c'?'people':'building';
              const label=tab==='p'?'کاڵایەک نەدۆزرایەوە':tab==='c'?'کڕیارێک نەدۆزرایەوە':'دابینکەرێک نەدۆزرایەوە';
              tbody.innerHTML=`<tr><td colspan="10" class="empty-state"><i class="bi bi-${icon}"></i><p style="margin:0;font-size:12px;">${label}</p></td></tr>`;
              return;
          }
          if (tab==='p') tbody.innerHTML = rows.map((p,i) => rowP(p, startIdx+i)).join('');
          if (tab==='c') tbody.innerHTML = rows.map((c,i) => rowC(c, startIdx+i)).join('');
          if (tab==='s' && !_isCashier) tbody.innerHTML = rows.map((s,i) => rowS(s, startIdx+i)).join('');
        }

        function fmt(n) { return new Intl.NumberFormat('en').format(Math.round(n)); }
        function esc(s) { return String(s||'').replace(/'/g,"\\'"); }

        function rowP(p, idx) {
          const sc = p.currentStock===0?'bsz':p.currentStock<5?'bsl':'bso';
          const uParts = [];
          if (p.qtyPerCarton>1) uParts.push(`<span class="uc uc-k">📦 ${p.qtyPerCarton}</span>`);
          if (p.qtyPerDozen>1)  uParts.push(`<span class="uc uc-d">🔢 ${p.qtyPerDozen}</span>`);
          if (p.qtyPerBundle>1) uParts.push(`<span class="uc uc-b">📎 ${p.qtyPerBundle}</span>`);
          const units = uParts.length ? uParts.join('') : '<span style="color:var(--text-dim);font-size:11px;">—</span>';
          const profitVal = p.salePrice - p.lastPurchasePrice;
          const profit = p.lastPurchasePrice>0 ? `<span class="profit-pos">+${fmt(profitVal)}</span>` : '<span style="color:var(--text-dim);font-size:11px;">—</span>';
          const status = p.isActive?'<span class="b-on">چالاک</span>':'<span class="b-off">ئەرشیف</span>';

          // ئەگەر کشێر بێت دوگمەکانی نابێت
          const actionBtns = _isCashier ? '' : `
            <td><div class="act-grp">
              <button class="act-btn ab-e" onclick="editProduct(${p.productId})" title="دەستکاری"><i class="bi bi-pencil"></i></button>
              <button class="act-btn ab-d" onclick="hardDel('product',${p.productId},'${esc(p.name)}')" title="سڕینەوە"><i class="bi bi-trash"></i></button>
            </div></td>`;

          return `<tr class="${p.isActive?'':'archived'}">
            <td style="text-align:center;color:var(--text-dim);font-size:11px;">${idx}</td>
            <td><span style="font-weight:600;color:var(--text-primary);">${p.name}</span></td>
            <td><span class="iv-barcode" style="font-family:monospace;font-size:11px;color:var(--text-dim);letter-spacing:.5px;">${p.barcode}</span></td>
            <td style="text-align:center;"><span class="${sc}">${p.currentStock}</span></td>
            <td><div class="unit-chips">${units}</div></td>
            <td style="text-align:center;font-weight:600;color:var(--accent-text);">${fmt(p.salePrice)}</td>
            <td style="text-align:center;color:var(--text-muted);">${fmt(p.wholesalePrice)}</td>
            <td style="text-align:center;">${profit}</td>
            <td style="text-align:center;">${status}</td>
            ${actionBtns}
          </tr>`;
        }

        function rowC(c, idx) {
          const bc = c.balance<0?'b-bn':c.balance>0?'b-bp':'b-bz';
          const bl = c.balance<0?`قەرز ${fmt(Math.abs(c.balance))}`:c.balance>0?`قەرز ${fmt(c.balance)}`:'٠';
          const ph = c.phone?`<span style="font-family:monospace;font-size:11px;display:flex;align-items:center;gap:5px;color:var(--text-secondary);"><i class="bi bi-telephone" style="color:var(--text-dim);font-size:10px;"></i>${c.phone}</span>`:'<span style="color:var(--text-dim);font-size:11px;">—</span>';
          const ad = c.address?`<span style="color:var(--text-muted);font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block;">${c.address}</span>`:'<span style="color:var(--text-dim);font-size:11px;">—</span>';

          const actionBtns = _isCashier ? '' : `
            <td><div class="act-grp">
              <button class="act-btn ab-e" onclick="editCustomer(${c.customerId})" title="دەستکاری"><i class="bi bi-pencil"></i></button>
              <button class="act-btn ab-d" onclick="hardDel('customer',${c.customerId},'${esc(c.name)}')" title="سڕینەوە"><i class="bi bi-trash"></i></button>
            </div></td>`;

          return `<tr>
            <td style="text-align:center;color:var(--text-dim);font-size:11px;">${idx}</td>
            <td><span style="font-weight:600;color:var(--text-primary);">${c.name}</span></td>
            <td>${ph}</td>
            <td>${ad}</td>
            <td style="text-align:center;"><span class="${bc}">${bl}</span></td>
            ${actionBtns}
          </tr>`;
        }

        function rowS(s, idx) {
          if(_isCashier) return ''; // بۆ دڵنیایی زیاتر
          const isDef = s.supplierId===1;
          const ph = s.phone?`<span style="font-family:monospace;font-size:11px;display:flex;align-items:center;gap:5px;color:var(--text-secondary);"><i class="bi bi-telephone" style="color:var(--text-dim);font-size:10px;"></i>${s.phone}</span>`:'<span style="color:var(--text-dim);font-size:11px;">—</span>';
          const ad = s.address?`<span style="color:var(--text-muted);font-size:12px;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block;">${s.address}</span>`:'<span style="color:var(--text-dim);font-size:11px;">—</span>';
          const status = s.isActive?'<span class="b-on">چالاک</span>':'<span class="b-off">ئەرشیف</span>';
          const btns = isDef ? '<button class="act-btn ab-e" disabled><i class="bi bi-lock"></i></button><button class="act-btn ab-d" disabled><i class="bi bi-lock"></i></button>' : `<button class="act-btn ab-e" onclick="editSupplier(${s.supplierId})" title="دەستکاری"><i class="bi bi-pencil"></i></button><button class="act-btn ab-d" onclick="hardDel('supplier',${s.supplierId},'${esc(s.name)}')" title="سڕینەوە"><i class="bi bi-trash"></i></button>`;

          return `<tr class="${s.isActive?'':'archived'}">
            <td style="text-align:center;color:var(--text-dim);font-size:11px;">${idx}</td>
            <td><span style="font-weight:${isDef?'500':'600'};color:${isDef?'var(--text-dim)':'var(--text-primary)'};">${s.name}</span></td>
            <td>${ph}</td>
            <td>${ad}</td>
            <td style="text-align:center;"><span class="b-cnt">${s.purchaseCount}</span></td>
            <td style="text-align:center;">${status}</td>
            <td><div class="act-grp">${btns}</div></td>
          </tr>`;
        }

        // ══ CRUD ══
        function openAddProduct(){ ['prod-id','prod-name','prod-barcode','prod-sale','prod-wholesale'].forEach(i=>_$(i).value=''); _$('prod-carton').value=_$('prod-dozen').value=_$('prod-bundle').value='1'; _$('prod-active-row').style.display='none'; showMsg('prod-msg',''); _$('prod-ttl').textContent='کاڵای نوێ'; new bootstrap.Modal(_$('m-product')).show(); setTimeout(()=>_$('prod-name').focus(),200); }
        async function editProduct(id){
            if(_isCashier) return;
            const d=await(await fetch('?handler=Product&id='+id)).json(); if(!d.success)return; _$('prod-ttl').textContent='دەستکاری کاڵا'; _$('prod-id').value=d.productId; _$('prod-name').value=d.name; _$('prod-barcode').value=d.barcode; _$('prod-sale').value=d.salePrice; _$('prod-wholesale').value=d.wholesalePrice; _$('prod-carton').value=d.qtyPerCarton; _$('prod-dozen').value=d.qtyPerDozen; _$('prod-bundle').value=d.qtyPerBundle; _$('prod-active-row').style.display='block'; _$('prod-active').checked=d.isActive; showMsg('prod-msg',''); new bootstrap.Modal(_$('m-product')).show();
        }
        async function saveProd(){
            const name=(_$('prod-name').value||'').trim(),bc=(_$('prod-barcode').value||'').trim(),sale=_$('prod-sale').value; if(!name||!bc||!sale){showMsg('prod-msg','ناو، باڕکۆد و نرخ پێویستن',false);return;}
            const isEdit=!!_$('prod-id').value;
            if(isEdit && _isCashier) return; // کشێر ناتوانێت دەستکاری بکات

            const fd=new FormData(); fd.append('ProductInput.ProductId',_$('prod-id').value||'0'); fd.append('ProductInput.Name',name); fd.append('ProductInput.Barcode',bc); fd.append('ProductInput.SalePrice',sale); fd.append('ProductInput.WholesalePrice',_$('prod-wholesale').value||'0'); fd.append('ProductInput.QtyPerCarton',_$('prod-carton').value||'1'); fd.append('ProductInput.QtyPerDozen',_$('prod-dozen').value||'1'); fd.append('ProductInput.QtyPerBundle',_$('prod-bundle').value||'1'); fd.append('ProductInput.IsActive',isEdit?String(_$('prod-active').checked):'true'); fd.append('__RequestVerificationToken',_tok());
            const r=await(await fetch('?handler='+(isEdit?'UpdateProduct':'AddProduct'),{method:'POST',body:fd})).json();
            if(r.success){ bootstrap.Modal.getInstance(_$('m-product'))?.hide(); loadTab('p'); refreshStats(); }
            else showMsg('prod-msg',r.message||'هەڵە',false);
        }

        function openAddCustomer(){ ['cust-id','cust-name','cust-phone','cust-address'].forEach(i=>_$(i).value=''); showMsg('cust-msg',''); _$('cust-ttl').textContent='کڕیاری نوێ'; new bootstrap.Modal(_$('m-customer')).show(); setTimeout(()=>_$('cust-name').focus(),200); }
        async function editCustomer(id){
            if(_isCashier) return;
            const d=await(await fetch('?handler=Customer&id='+id)).json(); if(!d.success)return; _$('cust-ttl').textContent='دەستکاری کڕیار'; _$('cust-id').value=d.customerId; _$('cust-name').value=d.name; _$('cust-phone').value=d.phone; _$('cust-address').value=d.address; showMsg('cust-msg',''); new bootstrap.Modal(_$('m-customer')).show();
        }
        async function saveCust(){
            const name=(_$('cust-name').value||'').trim(); if(!name){showMsg('cust-msg','ناوی کڕیار پێویستە',false);return;}
            const isEdit=!!_$('cust-id').value;
            if(isEdit && _isCashier) return;

            const fd=new FormData(); fd.append('CustomerInput.CustomerId',_$('cust-id').value||'0'); fd.append('CustomerInput.Name',name); fd.append('CustomerInput.Phone',_$('cust-phone').value||''); fd.append('CustomerInput.Address',_$('cust-address').value||''); fd.append('__RequestVerificationToken',_tok());
            const r=await(await fetch('?handler='+(isEdit?'UpdateCustomer':'AddCustomer'),{method:'POST',body:fd})).json();
            if(r.success){ bootstrap.Modal.getInstance(_$('m-customer'))?.hide(); loadTab('c'); refreshStats(); }
            else showMsg('cust-msg',r.message||'هەڵە',false);
        }

        function openAddSupplier(){ if(_isCashier) return; ['sup-id','sup-name','sup-phone','sup-address'].forEach(i=>_$(i).value=''); _$('sup-active-row').style.display='none'; showMsg('sup-msg',''); _$('sup-ttl').textContent='دابینکەری نوێ'; new bootstrap.Modal(_$('m-supplier')).show(); setTimeout(()=>_$('sup-name').focus(),200); }
        async function editSupplier(id){ if(_isCashier) return; const d=await(await fetch('?handler=Supplier&id='+id)).json(); if(!d.success)return; _$('sup-ttl').textContent='دەستکاری دابینکەر'; _$('sup-id').value=d.supplierId; _$('sup-name').value=d.name; _$('sup-phone').value=d.phone; _$('sup-address').value=d.address; _$('sup-active-row').style.display='block'; _$('sup-active').checked=d.isActive; showMsg('sup-msg',''); new bootstrap.Modal(_$('m-supplier')).show(); }
        async function saveSup(){ if(_isCashier) return; const name=(_$('sup-name').value||'').trim(); if(!name){showMsg('sup-msg','ناوی دابینکەر پێویستە',false);return;} const isEdit=!!_$('sup-id').value; const fd=new FormData(); fd.append('SupplierInput.SupplierId',_$('sup-id').value||'0'); fd.append('SupplierInput.Name',name); fd.append('SupplierInput.Phone',_$('sup-phone').value||''); fd.append('SupplierInput.Address',_$('sup-address').value||''); fd.append('SupplierInput.IsActive',isEdit?String(_$('sup-active').checked):'true'); fd.append('__RequestVerificationToken',_tok()); const r=await(await fetch('?handler='+(isEdit?'UpdateSupplier':'AddSupplier'),{method:'POST',body:fd})).json(); if(r.success){ bootstrap.Modal.getInstance(_$('m-supplier'))?.hide(); loadTab('s'); refreshStats(); } else showMsg('sup-msg',r.message||'هەڵە',false); }

        function hardDel(type,id,name){
            if(_isCashier) return;
            _act={t:'delete',type,id}; _$('conf-hdr').className='modal-header mh-re'; _$('conf-ttl').innerHTML='<i class="bi bi-trash"></i> سڕینەوەی تەواو'; _$('conf-ico').className='bi bi-exclamation-triangle'; _$('conf-ico').style.color='var(--warning)'; _$('conf-txt').textContent=`"${name}" بەتەواوی دەسڕێتەوە؟`; _$('conf-sub').textContent='ئەگەر داتای پێوەندی هەبێت، سیستەم ڕەتی دەکاتەوە.'; _$('conf-ok').style.background='linear-gradient(135deg,#ef4444,#dc2626)'; _$('conf-ok').textContent='بەڵێ، بسڕەوە'; showMsg('conf-msg',''); new bootstrap.Modal(_$('m-confirm')).show();
        }

        async function doConfirm(){
            if(!_act || _isCashier) return;
            showMsg('conf-msg',''); const fd=new FormData(); fd.append('__RequestVerificationToken',_tok()); const tab=_act.type==='product'?'p':_act.type==='customer'?'c':'s'; let url=''; if(_act.type==='supplier'){fd.append('DeleteSupplierId',_act.id);url='?handler=DeleteSupplier';} else url='?handler=Delete'+(_act.type==='product'?'Product':'Customer')+'&id='+_act.id; const r=await(await fetch(url,{method:'POST',body:fd})).json(); if(r.success){ bootstrap.Modal.getInstance(_$('m-confirm'))?.hide(); loadTab(tab); refreshStats(); } else showMsg('conf-msg',r.message||'هەڵە',false);
        }
    </script>
}