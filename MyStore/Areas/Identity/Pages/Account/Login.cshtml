@page
@model LoginModel
@{
    ViewData["Title"] = "چووناژوورەوە";
    Layout = null;
}

<!doctype html>
<html lang="ku" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - سیستەمی فرۆشتنی @Model.StoreName</title>

    <!-- Bootstrap RTL -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap');

        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --bg-color: #f3f4f6;
            --text-main: #111827;
            --text-muted: #6b7280;
            --card-radius: 24px;
            --input-radius: 12px;
        }

        body {
            font-family: 'IBM Plex Sans Arabic', sans-serif;
            background-color: var(--bg-color);
            background-image: radial-gradient(circle at top right, #e0e7ff 0%, #f3f4f6 40%);
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-wrapper {
            width: 100%;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* کارتی ستوونی (Vertical) */
        .login-card {
            background: #ffffff;
            border-radius: var(--card-radius);
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 450px;
            padding: 40px 30px;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.5);
        }

            /* هێڵێکی جوان لە سەرەوەی کارتەکە */
            .login-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 5px;
                background: linear-gradient(90deg, var(--primary-color), #818cf8);
            }

        .brand-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .logo-circle {
            width: 85px;
            height: 85px;
            background: linear-gradient(135deg, var(--primary-color) 0%, #818cf8 100%);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            margin: 0 auto 16px;
            box-shadow: 0 10px 20px rgba(79, 70, 229, 0.2);
            overflow: hidden;
        }

            .logo-circle img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .brand-header h2 {
            font-weight: 800;
            font-size: 24px;
            color: var(--text-main);
            margin-bottom: 8px;
        }

        .brand-header p {
            color: var(--text-muted);
            font-size: 14px;
            margin: 0;
        }

        .form-group label {
            font-weight: 700;
            color: #4b5563;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .input-icon-wrapper {
            position: relative;
        }

            .input-icon-wrapper i {
                position: absolute;
                left: 18px;
                top: 50%;
                transform: translateY(-50%);
                color: #9ca3af;
                transition: all 0.3s ease;
                z-index: 5;
                font-size: 18px;
            }

        .form-control-custom {
            height: 54px;
            border-radius: var(--input-radius);
            background-color: #f9fafb;
            border: 1.5px solid #e5e7eb;
            padding-left: 50px !important;
            padding-right: 18px !important;
            font-size: 15px;
            font-weight: 600;
            transition: all 0.3s ease;
            color: var(--text-main);
        }

            .form-control-custom:focus {
                background-color: #ffffff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
                outline: none;
            }

                .form-control-custom:focus + i,
                .form-control-custom:not(:placeholder-shown) + i {
                    color: var(--primary-color);
                }

        .btn-login {
            background: linear-gradient(135deg, var(--primary-color), #6366f1);
            border: none;
            border-radius: var(--input-radius);
            height: 54px;
            font-size: 16px;
            font-weight: 700;
            color: white;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            margin-top: 15px;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(79, 70, 229, 0.25);
                color: white;
            }

            .btn-login:active {
                transform: translateY(0);
            }

        .form-check-input {
            width: 1.2em;
            height: 1.2em;
            margin-top: 0.15em;
            cursor: pointer;
        }

            .form-check-input:checked {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
            }

        .form-check-label {
            cursor: pointer;
            font-size: 14px;
            color: var(--text-muted);
            margin-right: 8px;
        }

        .dir-ltr {
            direction: ltr;
            text-align: left;
        }
    </style>
</head>

<body>
    <div class="login-wrapper">
        <div class="login-card">

            <div class="brand-header">
                <div class="logo-circle">
                    @if (!string.IsNullOrEmpty(Model.StoreLogo))
                    {
                        <img src="@Model.StoreLogo" alt="Store Logo" />
                    }
                    else
                    {
                        <i class="fas fa-store"></i>
                    }
                </div>
                <h2>سیستەمی فرۆشتنی @Model.StoreName</h2>
                <p>تکایە زانیارییەکانت بنووسە بۆ چوونەژوورەوە</p>
            </div>

            <!-- فۆڕمەکە autocomplete ی ئاسایی کراوەتەوە بۆ ئەوەی بڕاوسەر کار بکات -->
            <form id="account" method="post">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" style="font-size:14px;" role="alert"></div>

                <!-- ئیمەیڵ -->
                <div class="form-group mb-4">
                    <label asp-for="Input.Email">ئیمەیڵ</label>
                    <div class="input-icon-wrapper">
                        <!-- autocomplete="username" یارمەتی بڕاوسەر دەدات ئیمەیڵەکە بدۆزێتەوە -->
                        <input asp-for="Input.Email" class="form-control form-control-custom dir-ltr" autocomplete="username" placeholder="example@store.com" />
                        <i class="fas fa-envelope"></i>
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- پاسۆرد -->
                <div class="form-group mb-4">
                    <label asp-for="Input.Password">وشەی تێپەڕ (Password)</label>
                    <div class="input-icon-wrapper">
                        <!-- autocomplete="current-password" یارمەتی بڕاوسەر دەدات پاسۆردەکە لۆد بکات -->
                        <input asp-for="Input.Password" class="form-control form-control-custom dir-ltr" autocomplete="current-password" placeholder="••••••••" />
                        <i class="fas fa-lock"></i>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- لەبیرت بمێنم -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check d-flex align-items-center">
                        <input class="form-check-input shadow-none" asp-for="Input.RememberMe" id="rememberMe" />
                        <label class="form-check-label user-select-none" for="rememberMe">
                            پاسۆردەکەم پاشەکەوت بکە
                        </label>
                    </div>
                </div>

                <!-- دوگمە -->
                <button id="login-submit" type="submit" class="btn-login shadow-sm">
                    چووناژوورەوە <i class="fas fa-sign-in-alt"></i>
                </button>

            </form>

            <div class="text-center mt-4">
                <small class="text-muted">© @DateTime.Now.Year @Model.StoreName</small>
            </div>

        </div>
    </div>

    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>